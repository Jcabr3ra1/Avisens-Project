.mt-contenedor {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

.mt-contenedor *,
.mt-contenedor *::before,
.mt-contenedor *::after {
  box-sizing: border-box;
}

/* Barra superior ---------------------------------------------------- */
.mt-barra {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-width: 0;
}

.mt-grupo {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 6px;
  min-width: 0;
}

.mt-btn {
  font: inherit;
  font-size: 0.82rem;
  font-weight: 700;
  line-height: 1;
  padding: 8px 13px;
  border-radius: 9px;
  border: 1px solid var(--border-subtle, #e2e0d6);
  background: var(--surface-base, #ffffff);
  color: var(--avisens-deep, #165b49);
  cursor: pointer;
  transition:
    background-color 0.15s ease,
    color 0.15s ease,
    border-color 0.15s ease;
}

.mt-btn:hover {
  background: var(--surface-tinted, #f4f3ec);
}

.mt-btn:focus-visible {
  outline: 2px solid var(--avisens-deep, #165b49);
  outline-offset: 2px;
}

.mt-btn.is-activo {
  background: var(--avisens-deep, #165b49);
  border-color: var(--avisens-deep, #165b49);
  color: var(--avisens-cream, #f5f2e8);
}

.mt-btn--edicion {
  border-color: var(--avisens-deep, #165b49);
}

.mt-btn--edicion.is-activo {
  background: var(--avisens-maize, #e4b84b);
  border-color: var(--avisens-maize, #e4b84b);
  color: var(--avisens-deep, #165b49);
}

/* Visor 3D ---------------------------------------------------------- */
.mt-visor {
  position: relative;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 410px;
  overflow: hidden;
  border-radius: var(--radius-xl, 16px);
  border: 1px solid var(--border-subtle, #e2e0d6);
  background: linear-gradient(
    180deg,
    var(--surface-base, #ffffff) 0%,
    var(--surface-tinted, #f4f3ec) 100%
  );
}

.mt-canvas {
  position: absolute;
  inset: 0;
  display: block;
  width: 100% !important;
  height: 100% !important;
  touch-action: none;
}

/* HUD de métricas --------------------------------------------------- */
.mt-hud {
  position: absolute;
  top: 12px;
  left: 12px;
  right: 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  pointer-events: none;
  z-index: 2;
}

.mt-metrica {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 92px;
  padding: 7px 11px;
  border-radius: 10px;
  border: 1px solid var(--border-subtle, #e2e0d6);
  background: color-mix(in srgb, var(--surface-base, #ffffff) 92%, transparent);
  backdrop-filter: blur(6px);
}

.mt-metrica__valor {
  font-size: 0.96rem;
  font-weight: 750;
  color: var(--avisens-deep, #165b49);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 210px;
  font-variant-numeric: tabular-nums;
}

.mt-metrica__etiqueta {
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--text-muted, #64746b);
}

/* Badges de sensores ------------------------------------------------ */
.mt-badge {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid var(--avisens-deep, #165b49);
  background: var(--surface-base, #ffffff);
  color: var(--avisens-deep, #165b49);
  font-size: 0.72rem;
  white-space: nowrap;
  pointer-events: auto;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
  will-change: transform;
}

.mt-badge__nombre {
  font-weight: 600;
  opacity: 0.85;
}

.mt-badge__valor {
  font-weight: 750;
}

.mt-badge--falla {
  border-color: var(--avisens-maize, #e4b84b);
  background: var(--accent-soft, #fef9c3);
  color: var(--warning, #92400e);
}

.mt-badge__accion {
  border: none;
  border-radius: 999px;
  padding: 2px 7px;
  background: var(--avisens-deep, #165b49);
  color: #ffffff;
  font-size: 0.66rem;
  font-weight: 700;
  cursor: pointer;
}

/* Avisos ------------------------------------------------------------ */
.mt-aviso {
  position: absolute;
  left: 50%;
  bottom: 48px;
  transform: translateX(-50%);
  z-index: 2;
  max-width: calc(100% - 24px);
  padding: 6px 12px;
  border-radius: 8px;
  background: var(--avisens-maize, #e4b84b);
  color: var(--avisens-deep, #165b49);
  font-size: 0.78rem;
  font-weight: 700;
  pointer-events: none;
}

.mt-aviso--centro {
  top: 50%;
  bottom: auto;
  transform: translate(-50%, -50%);
  background: var(--surface-base, #ffffff);
  border: 1px solid var(--border-subtle, #e2e0d6);
  font-weight: 600;
}

/* Leyenda ----------------------------------------------------------- */
.mt-leyenda {
  position: absolute;
  left: 12px;
  bottom: 12px;
  z-index: 2;
  width: min(210px, calc(100% - 24px));
  padding: 6px 10px 4px;
  border-radius: 8px;
  border: 1px solid var(--border-subtle, #e2e0d6);
  background: color-mix(in srgb, var(--surface-base, #ffffff) 92%, transparent);
  pointer-events: none;
}

.mt-leyenda__barra {
  height: 7px;
  border-radius: 4px;
  background: linear-gradient(
    90deg,
    #3b82c4,
    #4fb0a5,
    #7cc15a,
    #e4b84b,
    #e07a3a,
    #c8372d
  );
}

.mt-leyenda__ejes {
  display: flex;
  justify-content: space-between;
  margin-top: 3px;
  font-size: 0.68rem;
  font-weight: 650;
  color: var(--avisens-deep, #165b49);
}

/* Panel inferior de calibración ------------------------------------- */
.mt-panel-edicion {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px 14px;
  border-radius: var(--radius-xl, 16px);
  border: 1px solid var(--border-subtle, #e2e0d6);
  background: var(--surface-base, #ffffff);
  min-width: 0;
  max-width: 100%;
}

.mt-panel-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.mt-campo {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 0.78rem;
  color: var(--text-secondary, #334139);
}

.mt-campo input[type="range"] {
  width: 100%;
  accent-color: var(--avisens-deep, #165b49);
}

.mt-editor-sensor {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 10px;
  background: var(--surface-tinted, #f4f3ec);
  font-size: 0.78rem;
  color: var(--avisens-deep, #165b49);
}

@media (max-width: 640px) {
  .mt-visor {
    height: 320px;
  }
  .mt-metrica {
    min-width: 0;
    flex: 1 1 90px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .mt-btn {
    transition: none;
  }
}
