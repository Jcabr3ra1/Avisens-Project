.sensores-section {
  position: relative;
  padding: 6rem 1.5rem 6.5rem;
  background: #ffffff;
}

.sensores-head {
  max-width: 640px;
  margin: 0 auto 3.5rem;
  text-align: center;
}

.sensores-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  margin-bottom: 1.4rem;
  font-family: 'DM Mono', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(0, 91, 72, 0.78);
}

.sensores-eyebrow-line {
  flex: 0 0 40px;
  height: 1px;
  background: rgba(0, 91, 72, 0.3);
}

.sensores-eyebrow-txt {
  color: var(--avisens-deep);
  font-weight: 500;
}

.sensores-title {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: clamp(1.8rem, 3.6vw, 2.6rem);
  line-height: 1.15;
  letter-spacing: -0.025em;
  color: var(--avisens-deep);
  margin: 0 0 0.9rem;
  text-wrap: balance;
}

.sensores-sub {
  font-size: 1rem;
  line-height: 1.6;
  color: rgba(0, 91, 72, 0.75);
  margin: 0;
  text-wrap: balance;
}

.sensores-grid {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1.6rem;
  max-width: 980px;
  margin: 0 auto;
  padding: 0;
}

.sensor-card {
  flex: 1 1 280px;
  max-width: 320px;
  border-radius: 20px;
  overflow: hidden;
  background: var(--avisens-cream);
  border: 1px solid rgba(0, 91, 72, 0.14);
  box-shadow: 0 14px 34px -22px rgba(0, 91, 72, 0.28);
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}

.sensor-card:hover {
  transform: translateY(-4px);
  border-color: var(--avisens-green);
  box-shadow: 0 24px 48px -22px rgba(0, 91, 72, 0.36);
}

.sensor-card-foto {
  position: relative;
  aspect-ratio: 16 / 11;
  background: #f4f1e2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sensor-card-foto img {
  width: 78%;
  height: 78%;
  object-fit: contain;
}

.sensor-card-tag {
  position: absolute;
  top: 0.9rem;
  left: 0.9rem;
  padding: 0.28rem 0.75rem;
  border-radius: 999px;
  background: var(--avisens-deep);
  color: #ffffff;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.sensor-card-body {
  padding: 1.4rem 1.5rem 1.6rem;
}

.sensor-card-titulo {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--avisens-deep);
  margin: 0 0 0.55rem;
}

.sensor-card-texto {
  font-size: 0.88rem;
  line-height: 1.6;
  color: rgba(0, 91, 72, 0.82);
  margin: 0 0 1.2rem;
}

.sensor-card-footer {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.sensor-card-punto {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  flex-shrink: 0;
}

.sensor-card-punto--0 { background: var(--avisens-orange); }
.sensor-card-punto--1 { background: var(--avisens-yellow); }
.sensor-card-punto--2 { background: var(--avisens-green); }

.sensor-card-codigo {
  font-family: 'DM Mono', monospace;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  color: rgba(0, 91, 72, 0.55);
}

@media (max-width: 760px) {
  .sensores-section {
    padding: 4rem 1.2rem 4.5rem;
  }

  .sensores-head {
    margin-bottom: 2.2rem;
  }
}
