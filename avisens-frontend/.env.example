# Copia este archivo como .env y completa el valor.
# .env está en .gitignore: cada quien pone el suyo.

# A dónde apunta el frontend. En local, el backend levantado con Docker:
VITE_API_URL=http://localhost:3000/v1

# En Vercel se configura como variable del proyecto, apuntando al backend de
# Railway (con /v1 al final):
#   VITE_API_URL=https://avisens-project-production.up.railway.app/v1
#
# Y ese dominio de Vercel tiene que estar en CORS_ORIGIN del backend, o el
# navegador bloquea todas las llamadas. El error solo se ve en la consola del
# navegador, nunca en los logs del servidor.

# OJO: todo lo que empiece por VITE_ queda dentro del bundle que descarga
# cualquier visitante. Aquí NUNCA va una clave ni un secreto: si algo debe
# quedar oculto, tiene que pasar por el backend.
