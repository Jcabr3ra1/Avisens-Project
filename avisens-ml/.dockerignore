node_modules
package.json
package-lock.json

# Bytecode compilado en la maquina del desarrollador: la arquitectura puede no
# coincidir con la del contenedor.
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache

# Entornos virtuales locales.
.venv
venv

.git
.gitignore
*.md
requirements-dev.txt
test_*.py
Dockerfile
.dockerignore
