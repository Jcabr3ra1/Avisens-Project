# Variables de entorno de Avisens.
#
# Copia este archivo a `.env` y rellena los valores:
#     cp .env.example .env
#
# `.env` esta en .gitignore: NUNCA se sube. Este ejemplo si se versiona, para
# que quien clone el repositorio sepa que necesita.

# ---------------------------------------------------------------------------
# Base de datos y tokens (OBLIGATORIOS)
# ---------------------------------------------------------------------------
# Sin estos, `docker compose up` se niega a arrancar. Es a proposito: antes
# tenian un valor por defecto escrito en docker-compose.yml y cualquiera que
# leyera el repositorio publico conocia el secreto de produccion.
#
# Genera cada uno con:
#     openssl rand -base64 48 | tr -d '\n/+=' | head -c 48
#
# JWT_SECRET y JWT_REFRESH_SECRET deben tener al menos 32 caracteres y ser
# DISTINTOS entre si: si fueran iguales, un refresh token serviria como token
# de acceso.
POSTGRES_PASSWORD=cambia-esto
JWT_SECRET=cambia-esto-por-48-caracteres-aleatorios-minimo-32
JWT_REFRESH_SECRET=otro-distinto-de-48-caracteres-aleatorios

# ---------------------------------------------------------------------------
# Copiloto de IA (opcional)
# ---------------------------------------------------------------------------
# Sin la key, el copiloto responde que no esta configurado; el resto funciona.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (opcional)
# ---------------------------------------------------------------------------
# 'simulado' NO llama a Meta: registra el envio en el log. Es el valor por
# defecto para que nadie mande mensajes reales sin querer.
WHATSAPP_PROVIDER=simulado
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Minutos sin respuesta tras los cuales se cierra una conversacion de WhatsApp.
# Cerrar no pierde el progreso: si la persona vuelve dentro de 24 h, el bot le
# ofrece Continuar y retoma donde quedo. Quien esta contestando nunca se cierra.
WHATSAPP_MINUTOS_INACTIVIDAD=5

# Activa los jobs programados. En un despliegue con réplicas puede dejarse en
# true en todas: PostgreSQL coordina cada ventana y evita ejecuciones dobles.
JOBS_ENABLED=true
JOB_HISTORY_DAYS=30
IOT_IDEMPOTENCY_DAYS=30

# ---------------------------------------------------------------------------
# Solo desarrollo
# ---------------------------------------------------------------------------
# docker-compose.override.yml los usa para crear el admin local del seed.
ADMIN_EMAIL=admin@avisens.com
ADMIN_PASSWORD=Avisens2026!
