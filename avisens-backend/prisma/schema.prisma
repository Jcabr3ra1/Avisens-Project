generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticacion y roles
// ---------------------------------------------------------------------------

model Rol {
  id             Int      @id @default(autoincrement())
  nombre         String   @unique
  descripcion    String?
  activo         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  usuarios       Usuario[]
  roles_permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  modulo      String
  descripcion String?
  activo      Boolean @default(true)

  roles_permisos RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  id         Int @id @default(autoincrement())
  rol_id     Int
  permiso_id Int

  rol     Rol     @relation(fields: [rol_id], references: [id])
  permiso Permiso @relation(fields: [permiso_id], references: [id])

  @@unique([rol_id, permiso_id])
  @@map("roles_permisos")
}

model Usuario {
  id              Int      @id @default(autoincrement())
  rol_id          Int
  organizacion_id Int?
  nombre_completo String
  cedula          String   @unique
  email           String   @unique
  password_hash   String
  telefono        String?
  foto_url        String?
  huella_voz_url  String?
  pin_voz_hash    String?
  activo          Boolean  @default(true)
  fecha_creacion  DateTime @default(now())

  rol                        Rol                    @relation(fields: [rol_id], references: [id])
  seguridad_cuenta           SeguridadCuenta?
  sesiones                   Sesion[]
  granjas                    Granja[]
  pesajes                    Pesaje[]
  registros_mortalidad       RegistroMortalidad[]
  eventos_sanitarios         EventoSanitario[]
  consumos_diarios           ConsumoDiario[]
  registros_plagas           RegistroPlaga[]
  auditorias                 BitacoraAuditoria[]
  recuperaciones_solicitadas RecuperacionPassword[] @relation("RecuperacionSolicitante")
  recuperaciones_atendidas   RecuperacionPassword[] @relation("RecuperacionAdministrador")
  usuarios_galpones          UsuarioGalpon[]
  prospectos_asesorados      Prospecto[]
  solicitudes_pqrs           SolicitudPqrs[]
  notificaciones             Notificacion[]
  comandos_voz               ComandoVoz[]
  accionamientos             AccionamientoEquipo[]
  alertas_responsable        Alerta[]               @relation("AlertaResponsable")
  alertas_escalado           Alerta[]               @relation("AlertaEscalado")
  evidencias_alertas         EvidenciaAlerta[]
  ordenes_compra             OrdenCompra[]
  movimientos_financieros    MovimientoFinanciero[]
  movimientos_inventario     MovimientoInventario[]
  mantenimientos             Mantenimiento[]
  organizacion               Organizacion?          @relation(fields: [organizacion_id], references: [id], onDelete: Restrict)
  recomendaciones            Recomendacion[]
  conversaciones_ia          ConversacionIa[]
  mensajes_equipo            MensajeEquipo[]
  conversaciones_privadas_uno ConversacionPrivadaEquipo[] @relation("ConversacionPrivadaUno")
  conversaciones_privadas_dos ConversacionPrivadaEquipo[] @relation("ConversacionPrivadaDos")
  mensajes_privados_equipo    MensajePrivadoEquipo[]

  // Permite que la FK compuesta de granjas garantice que el propietario y la
  // granja pertenezcan a la misma organización.
  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@map("usuarios")
}

model SeguridadCuenta {
  id                           Int       @id @default(autoincrement())
  usuario_id                   Int       @unique
  intentos_fallidos            Int       @default(0)
  bloqueado_hasta              DateTime?
  fecha_ultimo_login           DateTime?
  fecha_ultimo_cambio_password DateTime?
  debe_cambiar_password        Boolean   @default(false)
  password_temporal_expira_en  DateTime?

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("seguridad_cuenta")
}

model Sesion {
  id                 Int      @id @default(autoincrement())
  usuario_id         Int
  refresh_token_hash String
  ip_origen          String?
  user_agent         String?
  expira_en          DateTime
  revocada           Boolean  @default(false)
  fecha_creacion     DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  // Postgres no indexa las FKs automáticamente; el refresh busca por usuario.
  @@index([usuario_id])
  @@map("sesiones")
}

// ---------------------------------------------------------------------------
// Monitoreo ambiental
// ---------------------------------------------------------------------------

model Granja {
  id              Int      @id @default(autoincrement())
  propietario_id  Int
  organizacion_id Int
  nombre          String
  direccion       String?
  municipio       String?
  departamento    String?
  latitud         Float?
  longitud        Float?
  area_total_m2   Float?
  activa          Boolean  @default(true)
  fecha_creacion  DateTime @default(now())

  propietario             Usuario                @relation(fields: [propietario_id, organizacion_id], references: [id, organizacion_id])
  organizacion            Organizacion           @relation(fields: [organizacion_id], references: [id])
  galpones                Galpon[]
  politicas_alerta        PoliticaAlerta[]
  clima                   Clima[]
  insumos                 InventarioInsumo[]
  ordenes_compra          OrdenCompra[]
  movimientos_financieros MovimientoFinanciero[]

  // El alcance por rol filtra siempre por dueño: granja.propietario_id = X.
  @@index([propietario_id])
  @@index([organizacion_id])
  @@map("granjas")
}

model Galpon {
  id                 Int       @id @default(autoincrement())
  granja_id          Int
  codigo             String // "galpon1" — coincide con el prefijo del topic MQTT
  nombre             String
  capacidad_aves     Int?
  ancho_metros       Float?
  largo_metros       Float?
  orientacion        String?
  tipo_techo         String?
  plano_url          String?
  activo             Boolean   @default(true)
  fecha_construccion DateTime? @db.Date

  granja               Granja                @relation(fields: [granja_id], references: [id])
  dispositivo          Dispositivo[]
  sensores             Sensor[]
  umbrales             UmbralAmbiental[]
  lotes                Lote[]
  usuarios_galpones    UsuarioGalpon[]
  comandos_voz         ComandoVoz[]
  zonas                ZonaGalpon[]
  alertas              Alerta[]
  equipos              Equipo[]
  recomendaciones      Recomendacion[]
  analisis_bioacustico AnalisisBioacustico[]
  mensajes_equipo      MensajeEquipo[]
  conversaciones_privadas ConversacionPrivadaEquipo[]
  analisis_vision      AnalisisVision[]

  // El código se repite entre granjas (cada una tiene su "galpon1"), pero es
  // único dentro de una misma granja.
  @@unique([granja_id, codigo])
  @@map("galpones")
}

// ---------------------------------------------------------------------------
// Dispositivos (nodos ESP32 que agrupan sensores en un galpon)
// ---------------------------------------------------------------------------

enum EstadoDispositivo {
  online
  offline
}

model Dispositivo {
  id                 Int               @id @default(autoincrement())
  galpon_id          Int
  mac_address        String            @unique
  codigo_topic       String            @unique
  nombre             String
  version_firmware   String?
  estado             EstadoDispositivo @default(offline)
  ip_local           String?
  // Secreto que el ESP32 manda en el header X-Device-Token de POST /ingest.
  // token_ingesta solo se conserva temporalmente para migrar instalaciones
  // anteriores; los tokens nuevos y migrados se guardan como SHA-256.
  token_ingesta      String?           @unique
  token_ingesta_hash String?           @unique
  ultima_conexion    DateTime?
  activo             Boolean           @default(true)
  fecha_creacion     DateTime          @default(now())

  galpon   Galpon               @relation(fields: [galpon_id], references: [id])
  sensores Sensor[]
  ingestas IngestaDispositivo[]

  // La relación compuesta impide conectar un sensor a un dispositivo de otro
  // galpón, incluso si se escribe directamente en la base de datos.
  @@unique([id, galpon_id])
  // Consulta frecuente: "dispositivos del galpón X". (Galpon no necesita esto:
  // su @@unique([granja_id, codigo]) ya indexa granja_id como prefijo.)
  @@index([galpon_id])
  @@map("dispositivos")
}

// ---------------------------------------------------------------------------
// Sensores (miden una variable ambiental y reportan via un dispositivo)
// ---------------------------------------------------------------------------

enum EstadoSensor {
  activo
  inactivo
  mantenimiento
  falla
}

model Sensor {
  id                  Int          @id @default(autoincrement())
  galpon_id           Int
  dispositivo_id      Int
  zona_id             Int?
  codigo              String       @unique
  tipo                String
  unidad_medida       String
  modelo              String?
  fabricante          String?
  coordenada_x        Float?
  coordenada_y        Float?
  altura_metros       Float?
  fecha_instalacion   DateTime?    @db.Date
  ultima_calibracion  DateTime?    @db.Date
  proxima_calibracion DateTime?    @db.Date
  estado              EstadoSensor @default(activo)

  mediciones  Medicion[]
  galpon      Galpon      @relation(fields: [galpon_id], references: [id])
  dispositivo Dispositivo @relation(fields: [dispositivo_id, galpon_id], references: [id, galpon_id])
  zona        ZonaGalpon? @relation(fields: [zona_id], references: [id])
  alertas     Alerta[]

  // Consultas frecuentes: "sensores del galpón X" y "sensores del nodo Y".
  @@index([galpon_id])
  @@index([dispositivo_id])
  @@map("sensores")
}

// ---------------------------------------------------------------------------
// Mediciones (serie de tiempo: una lectura de un sensor en un instante)
// ---------------------------------------------------------------------------

model Medicion {
  id         BigInt   @default(autoincrement())
  sensor_id  Int
  fecha_hora DateTime @default(now())
  valor      Float
  calidad    String   @default("ok")

  sensor Sensor @relation(fields: [sensor_id], references: [id])

  // PK compuesta (id, fecha_hora): deja la tabla lista para particionar por
  // rango de fecha si el histórico crece mucho (Postgres exige que la columna
  // de partición forme parte de la PK).
  @@id([id, fecha_hora])
  // La consulta reina será "lecturas del sensor X entre dos fechas".
  @@index([sensor_id, fecha_hora])
  @@map("mediciones")
}

// Registra cada lote recibido para deduplicar reintentos de los nodos IoT y
// conservar trazabilidad incluso si alguna lectura trae un código desconocido.
model IngestaDispositivo {
  id                  BigInt    @id @default(autoincrement())
  dispositivo_id      Int
  clave_idempotencia  String
  fecha_dispositivo   DateTime?
  fecha_recepcion     DateTime  @default(now())
  ip_origen           String?
  cantidad_recibida   Int
  cantidad_registrada Int
  codigos_ignorados   String[]  @default([])

  dispositivo Dispositivo @relation(fields: [dispositivo_id], references: [id])

  @@unique([dispositivo_id, clave_idempotencia])
  @@index([dispositivo_id, fecha_recepcion])
  @@map("ingestas_dispositivos")
}

enum EstadoEjecucionJob {
  ejecutando
  completado
  fallido
}

// Bloqueo distribuido y bitácora de los cron jobs. Evita que dos réplicas de
// la API ejecuten la misma ventana de trabajo al mismo tiempo.
model EjecucionJob {
  id            BigInt             @id @default(autoincrement())
  nombre        String
  clave_ventana String
  propietario   String
  estado        EstadoEjecucionJob @default(ejecutando)
  intentos      Int                @default(1)
  iniciada_en   DateTime           @default(now())
  expira_en     DateTime
  finalizada_en DateTime?
  error         String?

  @@unique([nombre, clave_ventana])
  @@index([estado, expira_en])
  @@map("ejecuciones_jobs")
}

// ---------------------------------------------------------------------------
// Umbrales ambientales (rango aceptable por variable/semana; versionado)
// ---------------------------------------------------------------------------

model UmbralAmbiental {
  id             Int      @id @default(autoincrement())
  galpon_id      Int
  variable       String
  semana_vida    Int
  valor_minimo   Float
  valor_maximo   Float
  unidad         String
  criticidad     String
  vigente        Boolean  @default(true)
  version        Int      @default(1)
  fecha_creacion DateTime @default(now())

  galpon Galpon @relation(fields: [galpon_id], references: [id])

  // No puede haber dos veces la misma versión de un mismo umbral.
  @@unique([galpon_id, variable, semana_vida, version])
  // Consulta reina: el umbral VIGENTE de un galpón para una variable y semana.
  @@index([galpon_id, variable, semana_vida, vigente])
  @@map("umbrales_ambientales")
}

// ---------------------------------------------------------------------------
// Proveedores (entidad global: quien suministra insumos, pollitos, etc.)
// ---------------------------------------------------------------------------

model Proveedor {
  id               Int      @id @default(autoincrement())
  nombre           String
  nit              String   @unique
  tipo_proveedor   String?
  contacto_persona String?
  telefono         String?
  email            String?
  direccion        String?
  activo           Boolean  @default(true)
  fecha_creacion   DateTime @default(now())

  insumos                 InventarioInsumo[]
  lotes                   Lote[]
  ordenes_compra          OrdenCompra[]
  movimientos_financieros MovimientoFinanciero[]

  @@map("proveedores")
}

// ---------------------------------------------------------------------------
// Inventario de insumos (stock de alimento, medicamentos, vacunas…)
// ---------------------------------------------------------------------------

model InventarioInsumo {
  id                    Int       @id @default(autoincrement())
  granja_id             Int
  nombre                String
  tipo                  String?
  unidad_medida         String
  stock_actual          Decimal   @default(0) @db.Decimal(14, 3)
  stock_minimo          Decimal   @default(0) @db.Decimal(14, 3)
  precio_unitario_cop   Decimal?  @db.Decimal(14, 2)
  proveedor_habitual_id Int?
  ubicacion_almacen     String?
  fecha_vencimiento     DateTime? @db.Date
  activo                Boolean   @default(true)
  fecha_actualizacion   DateTime  @default(now()) @updatedAt

  granja                   Granja                  @relation(fields: [granja_id], references: [id])
  proveedor_habitual       Proveedor?              @relation(fields: [proveedor_habitual_id], references: [id])
  eventos_sanitarios       EventoSanitario[]
  registros_plagas         RegistroPlaga[]
  movimientos_inventario   MovimientoInventario[]
  mantenimientos_repuestos MantenimientoRepuesto[]
  detalles_ordenes_compra  DetalleOrdenCompra[]

  @@index([granja_id])
  @@index([proveedor_habitual_id])
  @@map("inventario_insumos")
}

// ---------------------------------------------------------------------------
// Lotes (grupo de aves que entra junto y se cria como una unidad)
// ---------------------------------------------------------------------------

enum EstadoLote {
  activo
  finalizado
  inactivo
}

model Lote {
  id                     Int        @id @default(autoincrement())
  galpon_id              Int
  proveedor_id           Int
  codigo                 String     @unique
  fecha_ingreso          DateTime   @db.Date
  cantidad_inicial       Int
  raza                   String?
  sexo                   String?
  marca_alimento         String?
  costo_pollito_unitario Decimal?   @db.Decimal(14, 2)
  presupuesto_total_cop  Decimal?   @db.Decimal(14, 2)
  fecha_salida_estimada  DateTime?  @db.Date
  fecha_salida_real      DateTime?  @db.Date
  estado                 EstadoLote @default(activo)

  galpon    Galpon    @relation(fields: [galpon_id], references: [id])
  proveedor Proveedor @relation(fields: [proveedor_id], references: [id])

  pesajes                 Pesaje[]
  registros_mortalidad    RegistroMortalidad[]
  eventos_sanitarios      EventoSanitario[]
  consumos_diarios        ConsumoDiario[]
  registros_plagas        RegistroPlaga[]
  alertas                 Alerta[]
  ordenes_compra          OrdenCompra[]
  movimientos_financieros MovimientoFinanciero[]
  movimientos_inventario  MovimientoInventario[]
  predicciones            Prediccion[]
  recomendaciones         Recomendacion[]
  indicadores             IndicadorLote[]
  analisis_bioacustico    AnalisisBioacustico[]
  analisis_vision         AnalisisVision[]

  @@index([galpon_id, estado])
  @@map("lotes")
}

// ---------------------------------------------------------------------------
// Tipos de alimento (catalogo de alimentos por marca y etapa de vida)
// ---------------------------------------------------------------------------

model TipoAlimento {
  id                       Int     @id @default(autoincrement())
  nombre                   String
  marca                    String?
  etapa                    String?
  presentacion             String?
  dia_inicio               Int?
  dia_fin                  Int?
  consumo_total_esperado_g Float?
  activo                   Boolean @default(true)

  consumos_diarios ConsumoDiario[]

  @@map("tipos_alimento")
}

// ---------------------------------------------------------------------------
// Pesajes (peso promedio del lote por fecha; seguimiento de crecimiento)
// ---------------------------------------------------------------------------

model Pesaje {
  id                    Int      @id @default(autoincrement())
  lote_id               Int
  fecha                 DateTime @db.Date
  peso_promedio_g       Float
  cantidad_aves_pesadas Int?
  peso_minimo_g         Float?
  peso_maximo_g         Float?
  peso_objetivo_g       Float?
  alerta_generada       Boolean  @default(false)
  usuario_id            Int
  metodo_registro       String?
  observaciones         String?
  fecha_registro        DateTime @default(now())

  lote    Lote    @relation(fields: [lote_id], references: [id])
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@index([lote_id])
  @@map("pesajes")
}

// ---------------------------------------------------------------------------
// Registros de mortalidad (aves muertas por lote, causa y disposicion)
// ---------------------------------------------------------------------------

model RegistroMortalidad {
  id               Int      @id @default(autoincrement())
  lote_id          Int
  fecha            DateTime @db.Date
  cantidad_aves    Int
  causa_presuntiva String?
  disposicion      String?
  alerta_generada  Boolean  @default(false)
  usuario_id       Int
  metodo_registro  String?
  observaciones    String?
  fecha_registro   DateTime @default(now())

  lote    Lote    @relation(fields: [lote_id], references: [id])
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@index([lote_id])
  @@map("registros_mortalidad")
}

// ---------------------------------------------------------------------------
// Eventos sanitarios (vacunas, tratamientos y diagnosticos por lote)
// ---------------------------------------------------------------------------

model EventoSanitario {
  id              Int      @id @default(autoincrement())
  lote_id         Int
  // Insumo del inventario (vacuna/medicamento). Opcional: un diagnostico o una
  // revision no siempre gasta un insumo.
  insumo_id       Int?
  tipo            String // vacunacion | medicacion | tratamiento | diagnostico | revision
  diagnostico     String?
  producto        String?
  dosis           String?
  via_aplicacion  String?
  // A cuantas aves se aplico. Opcional: a veces es a todo el lote sin conteo.
  cantidad_aves   Int?
  fecha           DateTime @db.Date
  usuario_id      Int
  metodo_registro String?
  observaciones   String?
  fecha_registro  DateTime @default(now())

  lote    Lote              @relation(fields: [lote_id], references: [id])
  insumo  InventarioInsumo? @relation(fields: [insumo_id], references: [id])
  usuario Usuario           @relation(fields: [usuario_id], references: [id])

  @@index([lote_id])
  @@map("eventos_sanitarios")
}

// ---------------------------------------------------------------------------
// Consumos diarios (alimento en kg + agua en litros por lote y dia)
// ---------------------------------------------------------------------------

model ConsumoDiario {
  id               Int      @id @default(autoincrement())
  lote_id          Int
  // Que alimento se consumio. Opcional: a veces solo se registra agua.
  tipo_alimento_id Int?
  usuario_id       Int
  fecha            DateTime @db.Date
  alimento_kg      Float?
  agua_litros      Float?
  // La activa el motor de alertas; por ahora queda en false.
  alerta_agua_baja Boolean  @default(false)
  metodo_registro  String?
  fecha_registro   DateTime @default(now())

  lote          Lote          @relation(fields: [lote_id], references: [id])
  tipo_alimento TipoAlimento? @relation(fields: [tipo_alimento_id], references: [id])
  usuario       Usuario       @relation(fields: [usuario_id], references: [id])

  @@index([lote_id])
  @@map("consumos_diarios")
}

// ---------------------------------------------------------------------------
// Registros de plagas (plagas detectadas en el lote y su control)
// ---------------------------------------------------------------------------

model RegistroPlaga {
  id               Int      @id @default(autoincrement())
  lote_id          Int
  // Insumo usado para el control (opcional: puede ser control fisico/manual).
  insumo_id        Int?
  usuario_id       Int
  fecha            DateTime @db.Date
  tipo_plaga       String
  descripcion      String?
  control_aplicado String?
  metodo_registro  String?
  observaciones    String?
  fecha_registro   DateTime @default(now())

  lote    Lote              @relation(fields: [lote_id], references: [id])
  insumo  InventarioInsumo? @relation(fields: [insumo_id], references: [id])
  usuario Usuario           @relation(fields: [usuario_id], references: [id])

  @@index([lote_id])
  @@map("registros_plagas")
}

// ---------------------------------------------------------------------------
// Bitacora de auditoria (quien hizo que, cuando y desde donde)
// ---------------------------------------------------------------------------

model BitacoraAuditoria {
  id               Int      @id @default(autoincrement())
  usuario_id       Int?
  accion           String
  entidad_afectada String
  registro_id      Int?
  datos_antes      Json?
  datos_despues    Json?
  ip_origen        String?
  user_agent       String?
  fecha_hora       DateTime @default(now())

  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([entidad_afectada, registro_id])
  @@map("bitacora_auditoria")
}

// ---------------------------------------------------------------------------
// Recuperacion asistida: el usuario solicita y un administrador decide.
// ---------------------------------------------------------------------------
enum EstadoRecuperacionPassword {
  pendiente
  aprobada
  rechazada
  completada
}

model RecuperacionPassword {
  id              Int                        @id @default(autoincrement())
  usuario_id      Int
  estado          EstadoRecuperacionPassword @default(pendiente)
  motivo          String?
  ip_solicitud    String?
  atendida_por_id Int?
  atendida_en     DateTime?
  observacion     String?
  token_hash      String? // legado: el flujo nuevo no crea tokens públicos
  expira_en       DateTime?
  usado           Boolean                    @default(false)
  fecha_creacion  DateTime                   @default(now())

  usuario      Usuario  @relation("RecuperacionSolicitante", fields: [usuario_id], references: [id])
  atendida_por Usuario? @relation("RecuperacionAdministrador", fields: [atendida_por_id], references: [id])

  @@index([usuario_id, estado])
  @@index([atendida_por_id])
  @@map("recuperaciones_password")
}

// ---------------------------------------------------------------------------
// Usuarios por galpon (asigna operarios a galpones especificos)
// ---------------------------------------------------------------------------
model UsuarioGalpon {
  id               Int      @id @default(autoincrement())
  usuario_id       Int
  galpon_id        Int
  rol_asignacion   String?
  fecha_asignacion DateTime @default(now())
  activa           Boolean  @default(true)

  usuario Usuario @relation(fields: [usuario_id], references: [id])
  galpon  Galpon  @relation(fields: [galpon_id], references: [id])

  @@unique([usuario_id, galpon_id])
  @@index([galpon_id])
  @@index([galpon_id, usuario_id, activa])
  @@map("usuarios_galpones")
}

// ---------------------------------------------------------------------------
// Preguntas del chatbot (el flujo vive en datos: agregar o reordenar una
// pregunta NO requiere desplegar, es una fila)
// ---------------------------------------------------------------------------
model PreguntaChatbot {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique
  bloque          String
  orden           Int
  texto           String
  tipo            String
  opciones        Json?
  campo_prospecto String?
  puntua          Boolean  @default(false)
  obligatoria     Boolean  @default(true)
  omitir_si_canal String?
  siguiente       String?
  saltos          Json?
  activa          Boolean  @default(true)
  fecha_creacion  DateTime @default(now())

  respuestas RespuestaChatbot[]

  @@index([bloque, orden])
  @@map("preguntas_chatbot")
}

// ---------------------------------------------------------------------------
// Matriz de calificacion (puntaje que suma cada opcion de respuesta)
// ---------------------------------------------------------------------------
model MatrizCalificacion {
  id               Int      @id @default(autoincrement())
  bloque           String
  codigo_pregunta  String
  opcion_respuesta String
  puntaje          Int
  descripcion      String?
  activa           Boolean  @default(true)
  fecha_creacion   DateTime @default(now())

  respuestas RespuestaChatbot[]

  @@unique([codigo_pregunta, opcion_respuesta])
  @@map("matriz_calificacion")
}

// ---------------------------------------------------------------------------
// Prospectos (quien pide cotizacion: su ciclo de vida y calificacion).
// El estado es un enum: la restriccion vive en PostgreSQL, no en la aplicacion
// ---------------------------------------------------------------------------
enum EstadoProspecto {
  nuevo
  en_proceso
  calificado
  asignado
  cerrado
  abandonado
  cancelado
  pqrs
  consulta_atendida
  sin_consentimiento
}

model Prospecto {
  id                         Int             @id @default(autoincrement())
  sesion_id                  String          @unique
  nombre                     String?
  nombre_granja              String?
  tipo_documento             String?
  documento                  String?
  municipio                  String?
  departamento               String?
  numero_galpones            Int?
  area_granja_m2             Float?
  area_galpon_m2             Float?
  rol_prospecto              String?
  tipo_produccion            String?
  telefono                   String?
  email                      String?
  canal_origen               String?
  contacto_decisor           String?
  fecha_callback             DateTime?
  puntaje_total              Int?
  clasificacion              String?
  accion_siguiente           String?
  senal_caliente             Boolean         @default(false)
  conectividad_limitada      Boolean         @default(false)
  viabilidad_tecnica         String?
  estado                     EstadoProspecto @default(nuevo)
  pregunta_actual            String?
  ultima_pregunta            String?
  asesor_asignado_id         Int?
  ip_origen                  String?
  user_agent                 String?
  consentimiento_habeas_data Boolean         @default(false)
  fecha_inicio               DateTime        @default(now())
  ultima_actividad           DateTime        @default(now()) @updatedAt
  fecha_finalizacion         DateTime?

  asesor        Usuario?             @relation(fields: [asesor_asignado_id], references: [id])
  respuestas    RespuestaChatbot[]
  cotizaciones  Cotizacion[]
  interacciones InteraccionChatbot[]
  solicitudes   SolicitudPqrs[]

  @@index([asesor_asignado_id])
  @@map("prospectos")
}

// ---------------------------------------------------------------------------
// Respuestas del chatbot (lo que contesto el prospecto, con su puntaje)
// ---------------------------------------------------------------------------
model RespuestaChatbot {
  id               Int      @id @default(autoincrement())
  prospecto_id     Int
  pregunta_id      Int?
  matriz_id        Int?
  bloque           String?
  codigo_pregunta  String?
  pregunta_texto   String?
  respuesta_texto  String?
  puntaje_obtenido Int?
  fecha_respuesta  DateTime @default(now())

  prospecto Prospecto           @relation(fields: [prospecto_id], references: [id])
  pregunta  PreguntaChatbot?    @relation(fields: [pregunta_id], references: [id])
  matriz    MatrizCalificacion? @relation(fields: [matriz_id], references: [id])

  @@index([prospecto_id])
  @@map("respuestas_chatbot")
}

// ---------------------------------------------------------------------------
// Cotizaciones (propuesta generada al calificar, con su detalle de sensores)
// ---------------------------------------------------------------------------
model Cotizacion {
  id               Int       @id @default(autoincrement())
  prospecto_id     Int
  codigo           String?
  plan_recomendado String?
  numero_galpones  Int?
  numero_aves      Int?
  valor_total_cop  Decimal?  @db.Decimal(14, 2)
  url_pdf          String?
  canal_envio      String?
  estado           String    @default("generada")
  fecha_generacion DateTime  @default(now())
  fecha_envio      DateTime?

  prospecto Prospecto          @relation(fields: [prospecto_id], references: [id])
  sensores  CotizacionSensor[]

  @@index([prospecto_id])
  @@map("cotizaciones")
}

model CotizacionSensor {
  id            Int    @id @default(autoincrement())
  cotizacion_id Int
  tipo_sensor   String
  cantidad      Int

  cotizacion Cotizacion @relation(fields: [cotizacion_id], references: [id])

  @@index([cotizacion_id])
  @@map("cotizaciones_sensores")
}

// ---------------------------------------------------------------------------
// Interacciones del chatbot (traza de la conversacion mensaje a mensaje)
// ---------------------------------------------------------------------------
model InteraccionChatbot {
  id               Int      @id @default(autoincrement())
  prospecto_id     Int
  tipo             String?
  mensaje          String?
  intent_detectado String?
  confianza_nlu    Float?
  fecha_hora       DateTime @default(now())

  prospecto Prospecto @relation(fields: [prospecto_id], references: [id])

  @@index([prospecto_id])
  @@map("interacciones_chatbot")
}

// ---------------------------------------------------------------------------
// Solicitudes PQRS (bloque B: peticiones, quejas, reclamos, sugerencias)
// ---------------------------------------------------------------------------
model SolicitudPqrs {
  id              Int       @id @default(autoincrement())
  prospecto_id    Int
  categoria       String
  codigo_pregunta String?
  asunto          String?
  mensaje         String?
  respuesta       String?
  estado          String    @default("abierta")
  responsable_id  Int?
  fecha_creacion  DateTime  @default(now())
  fecha_cierre    DateTime?

  prospecto   Prospecto @relation(fields: [prospecto_id], references: [id])
  responsable Usuario?  @relation(fields: [responsable_id], references: [id])

  @@index([prospecto_id])
  @@index([responsable_id])
  @@map("solicitudes_pqrs")
}

// ---------------------------------------------------------------------------
// Asistente de voz (comandos de voz ejecutados en campo, con soporte offline)
// ---------------------------------------------------------------------------
model ComandoVoz {
  id                     Int      @id @default(autoincrement())
  usuario_id             Int
  galpon_id              Int
  tipo_comando           String?
  comando_texto          String?
  accion_ejecutada       String?
  confianza_nlu          Float?
  requiere_clarificacion Boolean  @default(false)
  modo_conexion          String?
  sincronizado           Boolean  @default(true)
  fecha_ejecucion        DateTime @default(now())
  fecha_recepcion        DateTime @default(now())
  id_sincronizacion      String?

  usuario Usuario @relation(fields: [usuario_id], references: [id])
  galpon  Galpon  @relation(fields: [galpon_id], references: [id])

  @@unique([usuario_id, id_sincronizacion])
  @@index([usuario_id])
  @@index([galpon_id])
  @@map("comandos_voz")
}

// ---------------------------------------------------------------------------
// Curvas objetivo (metas de peso/consumo por dia y sexo, guia de crecimiento)
// ---------------------------------------------------------------------------
model CurvaObjetivo {
  id                  Int     @id @default(autoincrement())
  marca               String  @default("italcol")
  fuente              String?
  sexo                String
  dia                 Int
  peso_esperado_g     Float?
  consumo_diario_g    Float?
  consumo_acumulado_g Float?
  fcr_objetivo        Float?
  etapa_alimentacion  String?
  temperatura_min     Float?
  temperatura_max     Float?

  @@unique([marca, sexo, dia])
  @@map("curvas_objetivo")
}

// ---------------------------------------------------------------------------
// Accionamientos de equipos (historial de encendido/apagado, manual o automatico)
// ---------------------------------------------------------------------------
enum EstadoAccionamiento {
  encendido
  apagado
}

model AccionamientoEquipo {
  id            Int                  @id @default(autoincrement())
  equipo_id     Int
  alerta_id     Int?
  origen        String?
  estado        EstadoAccionamiento?
  valor_disparo Float?
  usuario_id    Int?
  fecha_inicio  DateTime             @default(now())
  fecha_fin     DateTime?

  equipo  Equipo   @relation(fields: [equipo_id], references: [id])
  alerta  Alerta?  @relation(fields: [alerta_id], references: [id])
  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([equipo_id])
  @@map("accionamientos_equipos")
}

// ---------------------------------------------------------------------------
// Alertas (deteccion de condiciones fuera de umbral y su seguimiento)
// ---------------------------------------------------------------------------
model PoliticaAlerta {
  id                       Int      @id @default(autoincrement())
  granja_id                Int
  criticidad               String
  nivel_escalamiento       Int?
  canal                    String?
  tiempo_max_respuesta_seg Int?
  verificado               Boolean  @default(false)
  activa                   Boolean  @default(true)
  fecha_actualizacion      DateTime @default(now()) @updatedAt

  granja Granja @relation(fields: [granja_id], references: [id])

  @@index([granja_id])
  @@map("politicas_alerta")
}

enum EstadoAlerta {
  abierta
  en_proceso
  cerrada
}

model Alerta {
  id                Int          @id @default(autoincrement())
  galpon_id         Int
  lote_id           Int?
  sensor_id         Int?
  tipo              String
  criticidad        String
  valor_detectado   Float?
  valor_umbral      Float?
  mensaje           String?
  estado            EstadoAlerta @default(abierta)
  responsable_id    Int?
  escalado_a_id     Int?
  accion_correctiva String?
  fecha_creacion    DateTime     @default(now())
  fecha_aceptacion  DateTime?
  fecha_cierre      DateTime?

  galpon         Galpon                @relation(fields: [galpon_id], references: [id])
  lote           Lote?                 @relation(fields: [lote_id], references: [id])
  sensor         Sensor?               @relation(fields: [sensor_id], references: [id])
  responsable    Usuario?              @relation("AlertaResponsable", fields: [responsable_id], references: [id])
  escalado_a     Usuario?              @relation("AlertaEscalado", fields: [escalado_a_id], references: [id])
  canales        AlertaCanal[]
  evidencias     EvidenciaAlerta[]
  accionamientos AccionamientoEquipo[]

  @@index([galpon_id])
  @@index([lote_id])
  @@map("alertas")
}

model AlertaCanal {
  id           Int       @id @default(autoincrement())
  alerta_id    Int
  canal        String?
  estado_envio String?
  fecha_envio  DateTime?

  alerta Alerta @relation(fields: [alerta_id], references: [id])

  @@index([alerta_id])
  @@map("alertas_canales")
}

model EvidenciaAlerta {
  id             Int      @id @default(autoincrement())
  alerta_id      Int
  tipo_evidencia String?
  archivo_url    String?
  comentario     String?
  usuario_id     Int?
  tamano_bytes   Int?
  fecha_subida   DateTime @default(now())

  alerta  Alerta   @relation(fields: [alerta_id], references: [id])
  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([alerta_id])
  @@map("evidencias_alertas")
}

// ---------------------------------------------------------------------------
// Compras y finanzas (ordenes de compra, categorias y movimientos)
// ---------------------------------------------------------------------------
enum EstadoOrdenCompra {
  pendiente
  en_proceso
  entregada
  cancelada
}

model OrdenCompra {
  id                        Int               @id @default(autoincrement())
  granja_id                 Int
  proveedor_id              Int
  lote_id                   Int?
  codigo                    String
  fecha_pedido              DateTime?         @db.Date
  fecha_entrega_estimada    DateTime?         @db.Date
  fecha_entrega_real        DateTime?         @db.Date
  valor_total_cop           Decimal?          @db.Decimal(14, 2)
  estado                    EstadoOrdenCompra @default(pendiente)
  calificacion_cumplimiento Float?
  calificacion_calidad      Float?
  calificacion_tiempo       Float?
  usuario_id                Int
  fecha_registro            DateTime          @default(now())

  granja    Granja               @relation(fields: [granja_id], references: [id])
  proveedor Proveedor            @relation(fields: [proveedor_id], references: [id])
  lote      Lote?                @relation(fields: [lote_id], references: [id])
  usuario   Usuario              @relation(fields: [usuario_id], references: [id])
  detalles  DetalleOrdenCompra[]

  @@unique([granja_id, codigo])
  @@index([granja_id])
  @@index([proveedor_id])
  @@map("ordenes_compra")
}

model DetalleOrdenCompra {
  id                  Int     @id @default(autoincrement())
  orden_compra_id     Int
  insumo_id           Int
  cantidad            Decimal @db.Decimal(14, 3)
  cantidad_recibida   Decimal @default(0) @db.Decimal(14, 3)
  unidad_medida       String
  precio_unitario_cop Decimal @db.Decimal(14, 2)
  subtotal_cop        Decimal @db.Decimal(14, 2)

  orden       OrdenCompra            @relation(fields: [orden_compra_id], references: [id])
  insumo      InventarioInsumo       @relation(fields: [insumo_id], references: [id])
  movimientos MovimientoInventario[]

  @@unique([orden_compra_id, insumo_id])
  @@index([insumo_id])
  @@map("detalles_ordenes_compra")
}

model CategoriaFinanciera {
  id          Int     @id @default(autoincrement())
  nombre      String
  tipo        String?
  descripcion String?
  activo      Boolean @default(true)

  movimientos MovimientoFinanciero[]

  @@map("categorias_financieras")
}

model MovimientoFinanciero {
  id              Int      @id @default(autoincrement())
  granja_id       Int
  lote_id         Int?
  categoria_id    Int
  proveedor_id    Int?
  tipo            String?
  valor_cop       Decimal  @db.Decimal(14, 2)
  fecha           DateTime @db.Date
  descripcion     String?
  numero_factura  String?
  comprobante_url String?
  metodo_pago     String?
  usuario_id      Int
  fecha_registro  DateTime @default(now())

  granja    Granja              @relation(fields: [granja_id], references: [id])
  lote      Lote?               @relation(fields: [lote_id], references: [id])
  categoria CategoriaFinanciera @relation(fields: [categoria_id], references: [id])
  proveedor Proveedor?          @relation(fields: [proveedor_id], references: [id])
  usuario   Usuario             @relation(fields: [usuario_id], references: [id])

  @@index([granja_id])
  @@index([lote_id])
  @@index([categoria_id])
  @@map("movimientos_financieros")
}

enum TipoMovimientoInventario {
  entrada
  salida
  ajuste
}

model MovimientoInventario {
  id                      Int                      @id @default(autoincrement())
  insumo_id               Int
  lote_id                 Int?
  tipo_movimiento         TipoMovimientoInventario
  cantidad                Decimal                  @db.Decimal(14, 3)
  unidad_medida           String?
  motivo                  String?
  comprobante_url         String?
  stock_resultante        Decimal?                 @db.Decimal(14, 3)
  usuario_id              Int
  detalle_orden_compra_id Int?
  clave_idempotencia      String?
  fecha_movimiento        DateTime                 @default(now())

  insumo               InventarioInsumo       @relation(fields: [insumo_id], references: [id])
  lote                 Lote?                  @relation(fields: [lote_id], references: [id])
  usuario              Usuario                @relation(fields: [usuario_id], references: [id])
  detalle_orden_compra DetalleOrdenCompra?    @relation(fields: [detalle_orden_compra_id], references: [id])
  repuesto_salida      MantenimientoRepuesto? @relation("RepuestoSalida")
  repuesto_reversion   MantenimientoRepuesto? @relation("RepuestoReversion")

  @@unique([detalle_orden_compra_id, clave_idempotencia], map: "mov_inv_detalle_clave_key")
  @@index([detalle_orden_compra_id], map: "mov_inv_detalle_idx")
  @@index([insumo_id])
  @@index([lote_id])
  @@map("movimientos_inventario")
}

// ---------------------------------------------------------------------------
// Infraestructura y mantenimiento (zonas, equipos y su mantenimiento)
// ---------------------------------------------------------------------------
model ZonaGalpon {
  id                  Int     @id @default(autoincrement())
  galpon_id           Int
  codigo              String?
  nombre              String
  tipo_zona           String?
  coordenada_x_inicio Float?
  coordenada_y_inicio Float?
  coordenada_x_fin    Float?
  coordenada_y_fin    Float?
  color_visualizacion String?
  activa              Boolean @default(true)

  galpon   Galpon   @relation(fields: [galpon_id], references: [id])
  sensores Sensor[]
  equipos  Equipo[]

  @@index([galpon_id])
  @@map("zonas_galpon")
}

model Equipo {
  id                Int       @id @default(autoincrement())
  galpon_id         Int
  zona_id           Int?
  codigo            String    @unique
  nombre            String
  tipo              String?
  es_actuador       Boolean   @default(false)
  modelo            String?
  fabricante        String?
  serial            String?
  fecha_compra      DateTime? @db.Date
  fecha_instalacion DateTime? @db.Date
  vida_util_horas   Int?
  horas_operacion   Int?      @default(0)
  estado_actual     String    @default("operativo")
  modo_operacion    String?
  coordenada_x      Float?
  coordenada_y      Float?
  costo_cop         Decimal?  @db.Decimal(14, 2)

  galpon         Galpon                @relation(fields: [galpon_id], references: [id])
  zona           ZonaGalpon?           @relation(fields: [zona_id], references: [id])
  accionamientos AccionamientoEquipo[]
  mantenimientos Mantenimiento[]

  @@index([galpon_id])
  @@map("equipos")
}

model Mantenimiento {
  id                    Int       @id @default(autoincrement())
  equipo_id             Int
  tipo                  String?
  fecha_programada      DateTime? @db.Date
  fecha_ejecucion       DateTime? @db.Date
  duracion_horas        Float?
  tecnico_responsable   String?
  tecnico_id            Int?
  descripcion           String?
  costo_cop             Decimal?  @db.Decimal(14, 2)
  causa_falla           String?
  tiempo_inactivo_horas Float?
  estado                String    @default("programado")
  evidencia_url         String?
  observaciones         String?
  fecha_registro        DateTime  @default(now())

  equipo    Equipo                  @relation(fields: [equipo_id], references: [id])
  tecnico   Usuario?                @relation(fields: [tecnico_id], references: [id])
  repuestos MantenimientoRepuesto[]

  @@index([equipo_id])
  @@map("mantenimientos")
}

model MantenimientoRepuesto {
  id                      Int      @id @default(autoincrement())
  mantenimiento_id        Int
  insumo_id               Int
  descripcion             String?
  cantidad                Decimal  @db.Decimal(14, 3)
  unidad_medida           String
  costo_cop               Decimal? @db.Decimal(14, 2)
  clave_idempotencia      String
  movimiento_salida_id    Int?     @unique(map: "mant_repuesto_salida_key")
  movimiento_reversion_id Int?     @unique(map: "mant_repuesto_reversion_key")
  revertido               Boolean  @default(false)
  fecha_registro          DateTime @default(now())

  mantenimiento        Mantenimiento         @relation(fields: [mantenimiento_id], references: [id])
  insumo               InventarioInsumo      @relation(fields: [insumo_id], references: [id])
  movimiento_salida    MovimientoInventario? @relation("RepuestoSalida", fields: [movimiento_salida_id], references: [id])
  movimiento_reversion MovimientoInventario? @relation("RepuestoReversion", fields: [movimiento_reversion_id], references: [id])

  @@unique([mantenimiento_id, clave_idempotencia], map: "mant_repuesto_clave_key")
  @@index([mantenimiento_id])
  @@index([insumo_id])
  @@map("mantenimientos_repuestos")
}

// ---------------------------------------------------------------------------
// Organizaciones (multi-tenant / SaaS: agrupa usuarios por cliente/empresa)
// ---------------------------------------------------------------------------
model Organizacion {
  id             Int      @id @default(autoincrement())
  nombre         String
  nit            String?  @unique
  plan           String   @default("free")
  activa         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  usuarios Usuario[]
  granjas  Granja[]

  @@map("organizaciones")
}

// ---------------------------------------------------------------------------
// Indicadores del lote (KPIs historicos: FCR, EPEF, uniformidad por fecha)
// ---------------------------------------------------------------------------
model IndicadorLote {
  id                       Int      @id @default(autoincrement())
  lote_id                  Int
  fecha                    DateTime @db.Date
  dia_vida                 Int?
  peso_promedio_g          Float?
  fcr                      Float?
  epef                     Float?
  uniformidad_pct          Float?
  mortalidad_acumulada_pct Float?
  consumo_acumulado_g      Float?
  calculado_en             DateTime @default(now())

  lote Lote @relation(fields: [lote_id], references: [id])

  @@unique([lote_id, fecha])
  @@index([lote_id])
  @@map("indicadores_lote")
}

// ---------------------------------------------------------------------------
// Modelos de ML (registro de modelos, versiones y metricas)
// ---------------------------------------------------------------------------
model ModeloMl {
  id                  Int       @id @default(autoincrement())
  nombre              String
  tipo                String?
  objetivo            String?
  version             String?
  framework           String?
  metricas            Json?
  activo              Boolean   @default(true)
  fecha_entrenamiento DateTime?
  fecha_creacion      DateTime  @default(now())

  predicciones         Prediccion[]
  analisis_bioacustico AnalisisBioacustico[]
  analisis_vision      AnalisisVision[]

  @@unique([nombre, version])
  @@map("modelos_ml")
}

// ---------------------------------------------------------------------------
// Predicciones (salidas del modelo: peso futuro, FCR, riesgo de mortalidad)
// ---------------------------------------------------------------------------
model Prediccion {
  id               Int       @id @default(autoincrement())
  lote_id          Int?
  modelo_id        Int?
  tipo             String
  horizonte_dias   Int?
  valor_predicho   Float?
  unidad           String?
  confianza        Float?
  fecha_objetivo   DateTime? @db.Date
  datos_entrada    Json?
  fecha_generacion DateTime  @default(now())

  lote            Lote?           @relation(fields: [lote_id], references: [id])
  modelo          ModeloMl?       @relation(fields: [modelo_id], references: [id])
  recomendaciones Recomendacion[]

  @@index([lote_id])
  @@map("predicciones")
}

// ---------------------------------------------------------------------------
// Recomendaciones (lo que la IA sugiere hacer, con su estado)
// ---------------------------------------------------------------------------
enum EstadoRecomendacion {
  pendiente
  resuelta
}

model Recomendacion {
  id               Int                 @id @default(autoincrement())
  lote_id          Int?
  galpon_id        Int?
  prediccion_id    Int?
  tipo             String?
  titulo           String
  descripcion      String?
  accion_sugerida  String?
  prioridad        String              @default("media")
  estado           EstadoRecomendacion @default(pendiente)
  usuario_id       Int?
  fecha_generacion DateTime            @default(now())
  fecha_resolucion DateTime?

  lote       Lote?       @relation(fields: [lote_id], references: [id])
  galpon     Galpon?     @relation(fields: [galpon_id], references: [id])
  prediccion Prediccion? @relation(fields: [prediccion_id], references: [id])
  usuario    Usuario?    @relation(fields: [usuario_id], references: [id])

  @@index([lote_id])
  @@map("recomendaciones")
}

// ---------------------------------------------------------------------------
// Mensajes del equipo (chat interno por galpon)
// ---------------------------------------------------------------------------
// El hilo cuelga del GALPON, no de una pareja de personas. En una granja lo
// que importa es "que pasa en el galpon 3", no "que me dijo Pedro": el
// operario que entra manana necesita leer lo que se hablo ahi, aunque no
// estuviera en la conversacion. Ademas el alcance por rol sale solo, porque
// los operarios ya estan asignados a galpones.
model MensajeEquipo {
  id            Int       @id @default(autoincrement())
  galpon_id     Int
  emisor_id     Int
  contenido     String
  fecha_envio   DateTime  @default(now())
  fecha_lectura DateTime?

  galpon Galpon  @relation(fields: [galpon_id], references: [id])
  emisor Usuario @relation(fields: [emisor_id], references: [id])

  // El listado siempre pide "los mensajes de este galpon, del mas reciente al
  // mas antiguo": el indice cubre esa consulta entera.
  @@index([galpon_id, fecha_envio])
  @@index([emisor_id])
  @@map("mensajes_equipo")
}

model ConversacionPrivadaEquipo {
  id                   Int      @id @default(autoincrement())
  galpon_id            Int
  participante_uno_id  Int
  participante_dos_id  Int
  fecha_creacion       DateTime @default(now())
  ultimo_mensaje_en    DateTime?

  galpon           Galpon  @relation(fields: [galpon_id], references: [id])
  participante_uno Usuario @relation("ConversacionPrivadaUno", fields: [participante_uno_id], references: [id])
  participante_dos Usuario @relation("ConversacionPrivadaDos", fields: [participante_dos_id], references: [id])
  mensajes         MensajePrivadoEquipo[]

  @@unique([galpon_id, participante_uno_id, participante_dos_id])
  @@index([participante_uno_id])
  @@index([participante_dos_id])
  @@index([galpon_id])
  @@map("conversaciones_privadas_equipo")
}

model MensajePrivadoEquipo {
  id              Int      @id @default(autoincrement())
  conversacion_id Int
  emisor_id       Int
  contenido       String
  fecha_envio     DateTime @default(now())
  fecha_lectura   DateTime?

  conversacion ConversacionPrivadaEquipo @relation(fields: [conversacion_id], references: [id], onDelete: Cascade)
  emisor       Usuario                    @relation(fields: [emisor_id], references: [id])

  @@index([conversacion_id, fecha_envio])
  @@index([emisor_id])
  @@map("mensajes_privados_equipo")
}

// ---------------------------------------------------------------------------
// Copiloto IA (conversaciones y mensajes del asistente para el granjero)
// ---------------------------------------------------------------------------
model ConversacionIa {
  id                   Int       @id @default(autoincrement())
  usuario_id           Int
  titulo               String?
  contexto             Json?
  fecha_inicio         DateTime  @default(now())
  fecha_ultimo_mensaje DateTime?

  usuario  Usuario     @relation(fields: [usuario_id], references: [id])
  mensajes MensajeIa[]

  @@index([usuario_id])
  @@map("conversaciones_ia")
}

model MensajeIa {
  id              Int      @id @default(autoincrement())
  conversacion_id Int
  rol             String
  contenido       String
  tokens          Int?
  fecha           DateTime @default(now())

  conversacion ConversacionIa @relation(fields: [conversacion_id], references: [id])

  @@index([conversacion_id])
  @@map("mensajes_ia")
}

// ---------------------------------------------------------------------------
// Sensado avanzado (analisis por sonido y por imagen del ave)
// ---------------------------------------------------------------------------
model AnalisisBioacustico {
  id             Int      @id @default(autoincrement())
  galpon_id      Int
  lote_id        Int?
  modelo_id      Int?
  fecha_hora     DateTime @default(now())
  indicador      String?
  valor          Float?
  audio_url      String?
  interpretacion String?

  galpon Galpon    @relation(fields: [galpon_id], references: [id])
  lote   Lote?     @relation(fields: [lote_id], references: [id])
  modelo ModeloMl? @relation(fields: [modelo_id], references: [id])

  @@index([galpon_id])
  @@map("analisis_bioacustico")
}

model AnalisisVision {
  id            Int      @id @default(autoincrement())
  galpon_id     Int
  lote_id       Int?
  modelo_id     Int?
  fecha_hora    DateTime @default(now())
  tipo_analisis String?
  resultado     Json?
  imagen_url    String?

  galpon Galpon    @relation(fields: [galpon_id], references: [id])
  lote   Lote?     @relation(fields: [lote_id], references: [id])
  modelo ModeloMl? @relation(fields: [modelo_id], references: [id])

  @@index([galpon_id])
  @@map("analisis_vision")
}

// ---------------------------------------------------------------------------
// Clima (datos meteorologicos externos como contexto de la granja)
// ---------------------------------------------------------------------------
model Clima {
  id            Int      @id @default(autoincrement())
  granja_id     Int
  fecha_hora    DateTime @default(now())
  temperatura   Float?
  humedad       Float?
  precipitacion Float?
  viento_kmh    Float?
  fuente        String?

  granja Granja @relation(fields: [granja_id], references: [id])

  @@index([granja_id])
  @@map("clima")
}

// ---------------------------------------------------------------------------
// Catalogo de sensores (precios y cobertura para cotizar; los precios viven en
// datos para poder actualizarlos sin desplegar)
// ---------------------------------------------------------------------------
model CatalogoSensor {
  id                  Int      @id @default(autoincrement())
  tipo_sensor         String   @unique
  nombre              String
  descripcion         String?
  precio_unitario_cop Decimal  @db.Decimal(14, 2)
  cobertura_m2        Float?
  obligatorio         Boolean  @default(true)
  activo              Boolean  @default(true)
  fecha_actualizacion DateTime @updatedAt

  @@map("catalogo_sensores")
}

// ---------------------------------------------------------------------------
// Notificaciones internas (buzón para admin/propietario)
// ---------------------------------------------------------------------------
model Notificacion {
  id              Int      @id @default(autoincrement())
  usuario_id      Int
  tipo            String
  titulo          String
  mensaje         String
  leida           Boolean  @default(false)
  referencia_tipo String?
  referencia_id   Int?
  fecha_creacion  DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([leida])
  @@map("notificaciones")
}
