generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Rol {
  id             Int      @id @default(autoincrement())
  nombre         String   @unique
  descripcion    String?
  activo         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  usuarios       Usuario[]
  roles_permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          Int    @id @default(autoincrement())
  codigo      String @unique
  modulo      String
  descripcion String?
  activo      Boolean @default(true)

  roles_permisos RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  id         Int @id @default(autoincrement())
  rol_id     Int
  permiso_id Int

  rol     Rol     @relation(fields: [rol_id], references: [id])
  permiso Permiso @relation(fields: [permiso_id], references: [id])

  @@unique([rol_id, permiso_id])
  @@map("roles_permisos")
}

model Usuario {
  id               Int      @id @default(autoincrement())
  rol_id           Int
  nombre_completo  String
  cedula           String   @unique
  email            String   @unique
  password_hash    String
  telefono         String?
  activo           Boolean  @default(true)
  fecha_creacion   DateTime @default(now())

  rol              Rol               @relation(fields: [rol_id], references: [id])
  seguridad_cuenta SeguridadCuenta?
  sesiones         Sesion[]
  granjas          Granja[]

  @@map("usuarios")
}

model SeguridadCuenta {
  id                            Int       @id @default(autoincrement())
  usuario_id                    Int       @unique
  intentos_fallidos             Int       @default(0)
  bloqueado_hasta               DateTime?
  fecha_ultimo_login            DateTime?
  fecha_ultimo_cambio_password  DateTime?

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("seguridad_cuenta")
}

model Sesion {
  id                 Int      @id @default(autoincrement())
  usuario_id         Int
  refresh_token_hash String
  ip_origen          String?
  user_agent         String?
  expira_en          DateTime
  revocada           Boolean  @default(false)
  fecha_creacion     DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  // Postgres no indexa las FKs automáticamente; el refresh busca por usuario.
  @@index([usuario_id])
  @@map("sesiones")
}

// ---------------------------------------------------------------------------
// EP-04 · Monitoreo ambiental
// ---------------------------------------------------------------------------

model Granja {
  id             Int      @id @default(autoincrement())
  propietario_id Int
  nombre         String
  direccion      String?
  municipio      String?
  departamento   String?
  latitud        Float?
  longitud       Float?
  area_total_m2  Float?
  activa         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  propietario Usuario   @relation(fields: [propietario_id], references: [id])
  galpones    Galpon[]

  // El alcance por rol filtra siempre por dueño: granja.propietario_id = X.
  @@index([propietario_id])
  @@map("granjas")
}

model Galpon {
  id                 Int       @id @default(autoincrement())
  granja_id          Int
  codigo             String // "galpon1" — coincide con el prefijo del topic MQTT
  nombre             String
  capacidad_aves     Int?
  ancho_metros       Float?
  largo_metros       Float?
  orientacion        String?
  tipo_techo         String?
  plano_url          String?
  activo             Boolean   @default(true)
  fecha_construccion DateTime? @db.Date

  granja Granja @relation(fields: [granja_id], references: [id])
  dispositivo Dispositivo[]
  sensores Sensor[]
  umbrales UmbralAmbiental[]

  // El código se repite entre granjas (cada una tiene su "galpon1"), pero es
  // único dentro de una misma granja.
  @@unique([granja_id, codigo])
  @@map("galpones")
}

// ---------------------------------------------------------------------------
// EP-04 · Dispositivos (nodos ESP32 que agrupan sensores en un galpón)
// ---------------------------------------------------------------------------

model Dispositivo {
  id               Int       @id @default(autoincrement())
  galpon_id        Int
  mac_address      String    @unique
  codigo_topic     String    @unique
  nombre           String
  version_firmware String?
  estado           String    @default("offline")
  ip_local         String?
  // Secreto que el ESP32 manda en el header X-Device-Token de POST /ingest.
  // Nunca se expone en los listados; solo al crear el dispositivo o al regenerarlo.
  token_ingesta    String?   @unique
  ultima_conexion  DateTime?
  activo           Boolean   @default(true)
  fecha_creacion   DateTime  @default(now())

  galpon   Galpon   @relation(fields: [galpon_id], references: [id])
  sensores Sensor[]

  // Consulta frecuente: "dispositivos del galpón X". (Galpon no necesita esto:
  // su @@unique([granja_id, codigo]) ya indexa granja_id como prefijo.)
  @@index([galpon_id])
  @@map("dispositivos")
}

// ---------------------------------------------------------------------------
// EP-04 · Sensores (miden una variable ambiental y reportan vía un dispositivo)
// ---------------------------------------------------------------------------

model Sensor {
  id                 Int       @id @default(autoincrement())
  galpon_id          Int
  dispositivo_id     Int
  codigo             String    @unique
  tipo               String
  unidad_medida      String
  modelo             String?
  fabricante         String?
  coordenada_x       Float?
  coordenada_y       Float?
  altura_metros      Float?
  fecha_instalacion  DateTime? @db.Date
  ultima_calibracion DateTime? @db.Date
  proxima_calibracion DateTime? @db.Date
  estado             String    @default("activo")

  mediciones Medicion[]
  galpon      Galpon      @relation(fields: [galpon_id], references: [id])
  dispositivo Dispositivo @relation(fields: [dispositivo_id], references: [id])

  // Consultas frecuentes: "sensores del galpón X" y "sensores del nodo Y".
  @@index([galpon_id])
  @@index([dispositivo_id])
  @@map("sensores")
}

// ---------------------------------------------------------------------------
// EP-04 · Mediciones (serie de tiempo: una lectura de un sensor en un instante)
// ---------------------------------------------------------------------------

model Medicion {
  id         BigInt   @default(autoincrement())
  sensor_id  Int
  fecha_hora DateTime @default(now())
  valor      Float
  calidad    String   @default("ok")

  sensor Sensor @relation(fields: [sensor_id], references: [id])

  // PK compuesta (id, fecha_hora): TimescaleDB exigirá que la columna de
  // partición temporal haga parte de la PK cuando convirtamos a hypertable.
  @@id([id, fecha_hora])
  // La consulta reina será "lecturas del sensor X entre dos fechas".
  @@index([sensor_id, fecha_hora])
  @@map("mediciones")
}

// ---------------------------------------------------------------------------
// EP-04 · Umbrales ambientales (rango aceptable por variable/semana; versionado)
// ---------------------------------------------------------------------------

model UmbralAmbiental {
  id             Int      @id @default(autoincrement())
  galpon_id      Int
  variable       String
  semana_vida    Int
  valor_minimo   Float
  valor_maximo   Float
  unidad         String
  criticidad     String
  vigente        Boolean  @default(true)
  version        Int      @default(1)
  fecha_creacion DateTime @default(now())

  galpon Galpon @relation(fields: [galpon_id], references: [id])

  // No puede haber dos veces la misma versión de un mismo umbral.
  @@unique([galpon_id, variable, semana_vida, version])
  // Consulta reina: el umbral VIGENTE de un galpón para una variable y semana.
  @@index([galpon_id, variable, semana_vida, vigente])
  @@map("umbrales_ambientales")
}

// ---------------------------------------------------------------------------
// EP-07 · Proveedores (entidad global: quien suministra insumos, pollitos, etc.)
// ---------------------------------------------------------------------------

model Proveedor {
  id               Int      @id @default(autoincrement())
  nombre           String
  nit              String   @unique
  tipo_proveedor   String?
  contacto_persona String?
  telefono         String?
  email            String?
  direccion        String?
  activo           Boolean  @default(true)
  fecha_creacion   DateTime @default(now())

  insumos InventarioInsumo[]

  @@map("proveedores")
}

// ---------------------------------------------------------------------------
// EP-07 · Inventario de insumos (stock de alimento, medicamentos, vacunas…)
// ---------------------------------------------------------------------------

model InventarioInsumo {
  id                    Int       @id @default(autoincrement())
  nombre                String
  tipo                  String?
  unidad_medida         String
  stock_actual          Float     @default(0)
  stock_minimo          Float     @default(0)
  precio_unitario_cop   Float?
  proveedor_habitual_id Int?
  ubicacion_almacen     String?
  fecha_vencimiento     DateTime? @db.Date
  activo                Boolean   @default(true)
  fecha_actualizacion   DateTime  @default(now()) @updatedAt

  proveedor_habitual Proveedor? @relation(fields: [proveedor_habitual_id], references: [id])

  @@index([proveedor_habitual_id])
  @@map("inventario_insumos")
}
