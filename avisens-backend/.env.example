# Copia este archivo como .env y completa los valores.
# .env no se versiona (contiene secretos).
#
# Esto es solo para correr el backend SIN Docker (nest start:dev nativo).
# Con `docker compose up` desde la raiz, estas mismas claves salen del .env
# de la raiz (ver docker-compose.yml) -- este archivo no se lee dentro del
# contenedor.

# Puerto del servidor
PORT=3000

# Conexión a PostgreSQL
DATABASE_URL="postgresql://avisens:avisens@localhost:5432/avisens?schema=public"

# JWT — usa dos secretos LARGOS y DISTINTOS (access y refresh)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=otro-secreto-distinto-tambien-largo
JWT_REFRESH_EXPIRES_IN=7d

# Origen permitido para CORS (el frontend)
CORS_ORIGIN=http://localhost:8080

# Administrador Avisens — lo crea el seed (npm run seed).
# Si no defines ADMIN_USERNAME y ADMIN_PASSWORD, el seed NO crea ningun admin.
ADMIN_USERNAME=admin.avisens
# Contacto opcional, no se usa para ingresar.
ADMIN_EMAIL=admin@avisens.com
ADMIN_PASSWORD=cambia-esta-contrasena-fuerte
ADMIN_NOMBRE=Administrador Avisens
ADMIN_CEDULA=0000000000

# Copiloto IA — obtén la key en console.anthropic.com (cuenta aparte de Claude Code)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Redis (cola de trabajos en segundo plano con BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
# Desactiva todos los cron jobs en procesos que solo atienden HTTP.
JOBS_ENABLED=true
JOB_HISTORY_DAYS=30
IOT_IDEMPOTENCY_DAYS=30

# Tolerancia (en dias) para que generarAlertaDesvio() confie en el ultimo
# pesaje. Decision de negocio (2026-09-27): 2 dias -- es la tolerancia de
# la alerta, no el calendario de pesaje real (que es mas espaciado). Sin
# definir, la alerta se detiene con motivo=umbral_no_configurado.
UMBRAL_PESAJE_DIAS=2

# Servicio interno de modelos predictivos
ML_URL=http://localhost:8000
ML_TIMEOUT_MS=5000
ML_INTERNAL_TOKEN=cambia-esto-por-un-token-interno-de-32-caracteres

# Camara del galpon (ESP32-CAM -> POST /ingest/foto -> servicio ML /vision/detectar)
# Minutos sin moverse para marcar un pollo "quieto" y "posible muerto" (alerta).
VISION_QUIETO_MIN=5
VISION_MUERTO_MIN=60
# Confianza minima de una deteccion YOLO (0.05-0.95).
VISION_CONFIANZA=0.4
# Si pasan mas de estos segundos entre fotos, el seguimiento empieza de cero.
VISION_OLVIDAR_SEG=900
# Fotos guardadas por galpon (las de alertas se conservan) y dias de analisis.
VISION_MAX_CAPTURAS=200
VISION_RETENCION_DIAS=7

# Token del scraper de metricas (Prometheus). Sin el, /metrics queda abierto
# fuera de produccion; en produccion el arranque falla si no esta definido.
METRICS_TOKEN=cambia-esto-por-un-token-de-metricas-de-32-caracteres

# WhatsApp Cloud API. Con 'simulado' no llama a Meta: registra el envio en el log.
WHATSAPP_PROVIDER=simulado
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Minutos de inactividad antes de cerrar una conversacion de WhatsApp (default: 5)
WHATSAPP_MINUTOS_INACTIVIDAD=5
