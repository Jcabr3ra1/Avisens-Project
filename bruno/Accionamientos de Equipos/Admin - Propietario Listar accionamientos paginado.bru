meta {
  name: [Admin · Propietario]  Listar accionamientos paginado (Admin: todos - Propietario: los de sus granjas)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/accionamientos-equipos?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
}

auth:bearer {
  token: {{token}}
}
