meta {
  name: [Admin · Propietario]  Actualizar una política
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/politicas-alerta/1
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "criticidad": "Media",
    "canal": "Email",
    "nivel_escalamiento": 1,
    "tiempo_max_respuesta_seg": 600,
    "activa": true
  }
}
