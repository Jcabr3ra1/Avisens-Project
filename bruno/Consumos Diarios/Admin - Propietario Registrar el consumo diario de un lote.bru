meta {
  name: [Admin · Propietario]  Registrar el consumo diario de un lote
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/consumos-diarios
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "lote_id": 1,
    "fecha": "2026-08-09",
    "tipo_alimento_id": 1,
    "alimento_kg": 45.5,
    "agua_litros": 90,
    "metodo_registro": "manual"
  }
}
