meta {
  name: [Admin · Propietario]  Actualizar un usuario
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/usuarios/1
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre_completo": "María López",
    "cedula": "1098765432",
    "email": "maria@granja.com",
    "password": "contraseña123",
    "telefono": "3001234567",
    "rol_id": 2,
    "activo": true
  }
}
