meta {
  name: [Admin · Propietario]  Activar usuario
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/v1/usuarios/1/activar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Solo marca al usuario activo. No reactiva sus asignaciones de galpón ni sus
  sesiones: las asignaciones se reactivan una a una con
  PATCH /v1/usuarios-galpones/:id/activar o POST /v1/usuarios/:id/galpones.
}
