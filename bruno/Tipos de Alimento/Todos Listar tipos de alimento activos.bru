meta {
  name: [Todos]  Listar tipos de alimento (sólo los activos)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/tipos-alimento?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
}

auth:bearer {
  token: {{token}}
}

docs {
  Lo que necesita el desplegable del consumo diario: sólo los activos, en
  orden de día de vida. Lo leen los tres roles (catalogos:leer).
}
