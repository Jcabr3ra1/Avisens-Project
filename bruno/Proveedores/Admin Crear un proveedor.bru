meta {
  name: [Admin]  Crear un proveedor
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/proveedores
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
