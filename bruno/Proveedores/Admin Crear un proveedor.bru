    "nombre": "Alimentos del Campo S.A.S",
    "nit": "900123456-7",
    "tipo_proveedor": "alimento",
    "contacto_persona": "Juan Pérez",
    "telefono": "3001234567",
    "email": "ventas@alimentos.com",
    "direccion": "Calle 10 #20-30, Bogotá"
  }
}
