meta {
  name: [Todos]  Enviar un mensaje al galpón
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/mensajes-equipo
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "galpon_id": 1,
    "contenido": "El ventilador 2 está haciendo ruido desde anoche"
  }
}
