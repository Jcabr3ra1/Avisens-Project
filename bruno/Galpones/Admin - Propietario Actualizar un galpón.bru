meta {
  name: [Admin · Propietario]  Actualizar un galpón
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/galpones/1
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "granja_id": 1,
    "codigo": "galpon1",
    "nombre": "Galpón Norte",
    "capacidad_aves": 5000,
    "ancho_metros": 12.5,
    "largo_metros": 80,
    "orientacion": "norte-sur",
    "tipo_techo": "zinc",
    "plano_url": "https://.../plano.pdf",
    "fecha_construccion": "2024-03-15",
    "activo": true
  }
}

docs {
  Solo Administrador. Con "activo": false el galpón se desactiva y sus
  asignaciones activas de Operarios se revocan en la misma transacción,
  igual que con DELETE /v1/galpones/:id. Con "activo": true, o sin el
  campo "activo", las asignaciones no se modifican. Reactivar un galpón no
  devuelve el acceso a los Operarios: hay que volver a asignarlos con
  POST /v1/usuarios-galpones.
}
