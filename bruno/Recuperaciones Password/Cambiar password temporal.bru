meta {
  name: Cambiar contraseña temporal
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/recuperaciones-password/cambiar-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token_cambio_password}}
}

body:json {
  {
    "nueva_password": "MiNuevaClaveSegura2026"
  }
}

docs {
  Usa el token de cambio de contraseña que devuelve el login cuando la cuenta
  entra con una clave temporal, NO el token de sesión normal.
}
