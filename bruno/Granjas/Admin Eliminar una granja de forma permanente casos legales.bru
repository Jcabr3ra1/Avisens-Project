meta {
  name: [Admin]  Eliminar una granja de forma permanente (casos legales)
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/v1/granjas/1/permanente
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Sólo Administrador. El Propietario puede desactivar su granja (borrado
  suave), pero no eliminarla de forma permanente.
}
