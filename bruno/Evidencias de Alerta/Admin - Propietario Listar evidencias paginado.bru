meta {
  name: [Admin · Propietario]  Listar evidencias paginado (Admin: todas - Propietario: las de sus granjas)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/evidencias-alerta?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
}

auth:bearer {
  token: {{token}}
}
