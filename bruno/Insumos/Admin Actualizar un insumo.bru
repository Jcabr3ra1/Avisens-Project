meta {
  name: [Admin]  Actualizar un insumo
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/insumos/1
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Alimento iniciación",
    "tipo": "alimento",
    "unidad_medida": "kg",
    "stock_actual": 100,
    "stock_minimo": 20,
    "precio_unitario_cop": 2500,
    "proveedor_habitual_id": 1,
    "ubicacion_almacen": "Bodega A",
    "fecha_vencimiento": "2026-12-31",
    "activo": true
  }
}
