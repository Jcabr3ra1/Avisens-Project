meta {
  name: [Admin] Crear solicitud PQRS
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/solicitudes-pqrs
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "prospecto_id": 1,
    "categoria": "Reclamo",
    "asunto": "Los sensores no reportan",
    "mensaje": "Desde ayer el galpón 2 no manda temperatura."
  }
}

docs {
  fecha_limite se calcula por categoría: Reclamo 24 h; Queja y Petición 48 h;
  Sugerencia y Felicitación sin plazo. Una categoría fuera de la lista responde 400.
}
