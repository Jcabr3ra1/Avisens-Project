meta {
  name: [Admin · Propietario]  Registrar un sensor en un galpón
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/sensores
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
{
  "galpon_id": 1,
  "dispositivo_id": 1,
  "codigo": "TEMP-G1-01",
  "tipo": "temperatura",
  "unidad_medida": "°C",
  "modelo": "DHT22",
  "fabricante": "Aosong",
  "coordenada_x": 2.5,
  "coordenada_y": 4,
  "altura_metros": 1.8,
  "fecha_instalacion": "2026-07-24",
  "ultima_calibracion": "2026-07-24",
  "proxima_calibracion": "2026-10-24"
}
}
