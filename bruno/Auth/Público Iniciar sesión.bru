meta {
  name: [Público]  Iniciar sesión
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@avisens.com",
    "password": "contraseña123"
  }
}

script:post-response {
  const res = res.getBody();
  if (res && res.access_token) {
    bru.setEnvVar("token", res.access_token);
  }
  if (res && res.refresh_token) {
    bru.setEnvVar("refresh_token", res.refresh_token);
  }
}
