meta {
  name: [Admin · Propietario] Crear equipo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/equipos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
