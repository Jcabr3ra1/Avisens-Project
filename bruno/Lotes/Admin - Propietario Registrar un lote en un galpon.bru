  "cantidad_inicial": 5000,
  "raza": "Ross 308",
  "sexo": "mixto",
  "costo_pollito_unitario": 1200,
  "presupuesto_total_cop": 6000000,
  "fecha_salida_estimada": "2026-10-15"
}
}
