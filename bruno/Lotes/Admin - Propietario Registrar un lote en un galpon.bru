meta {
  name: [Admin · Propietario]  Registrar un lote en un galpon
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/lotes
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
{
  "galpon_id": 1,
  "proveedor_id": 1,
  "codigo": "LOTE-2026-01",
