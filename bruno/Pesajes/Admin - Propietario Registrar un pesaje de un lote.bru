meta {
  name: [Admin · Propietario]  Registrar un pesaje de un lote
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/pesajes
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "lote_id": 1,
    "fecha": "2026-08-08",
    "peso_promedio_g": 1850,
    "cantidad_aves_pesadas": 50,
    "peso_minimo_g": 1600,
    "peso_maximo_g": 2100,
    "peso_objetivo_g": 1900,
    "metodo_registro": "manual",
    "observaciones": "Lote parejo, buen crecimiento"
  }
}
