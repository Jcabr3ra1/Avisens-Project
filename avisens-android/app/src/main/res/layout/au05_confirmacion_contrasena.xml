<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4EF">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ========================================== -->
            <!-- TARJETA PRINCIPAL -->
            <!-- ========================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- ========================================== -->
                <!-- ICONO -->
                <!-- ========================================== -->

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginBottom="22dp"
                    android:background="@drawable/bg_icon_success"
                    android:contentDescription="Contraseña actualizada"
                    android:padding="17dp"
                    android:src="@drawable/ic_check"
                    android:tint="#2E9B6F" />

                <!-- ========================================== -->
                <!-- TÍTULO -->
                <!-- ========================================== -->

                <TextView
                    android:id="@+id/txtTituloConfirmacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="¡Contraseña actualizada!"
                    android:textColor="#17231F"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <!-- ========================================== -->
                <!-- DESCRIPCIÓN -->
                <!-- ========================================== -->

                <TextView
                    android:id="@+id/txtDescripcionConfirmacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Tu contraseña se cambió correctamente. Ahora puedes iniciar sesión con tu nueva contraseña."
                    android:textColor="#66736D"
                    android:textSize="15sp" />


                <!-- ========================================== -->
                <!-- BOTÓN VOLVER AL LOGIN -->
                <!-- ========================================== -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolverLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="Volver al inicio de sesión"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2E9B6F"
                    app:cornerRadius="10dp"
                    app:strokeWidth="0dp"
                    app:rippleColor="#24845D" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>