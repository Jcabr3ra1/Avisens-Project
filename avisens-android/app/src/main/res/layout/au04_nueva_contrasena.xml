<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4EF">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- =================================================
                 TARJETA PRINCIPAL
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- =================================================
                     ICONO
                     ================================================= -->

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="22dp"
                    android:background="@drawable/bg_icon_success"
                    android:contentDescription="Nueva contraseña"
                    android:padding="16dp"
                    android:src="@drawable/ic_lock"
                    android:tint="#2E9B6F" />

                <!-- =================================================
                     TITULO
                     ================================================= -->

                <TextView
                    android:id="@+id/txtTituloNuevaContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Nueva contraseña"
                    android:textColor="#17231F"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- =================================================
                     DESCRIPCION
                     ================================================= -->

                <TextView
                    android:id="@+id/txtDescripcionNuevaContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Crea una nueva contraseña segura para proteger tu cuenta."
                    android:textColor="#66736D"
                    android:textSize="15sp" />

                <!-- =================================================
                     NUEVA CONTRASEÑA
                     ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Nueva contraseña"
                    android:textColor="#26332E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNuevaContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ingresa tu nueva contraseña"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#26332E"
                    android:textColorHint="#98A49F"
                    android:textSize="15sp" />

                <!-- =================================================
                     CONFIRMAR CONTRASEÑA
                     ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Confirmar contraseña"
                    android:textColor="#26332E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtConfirmarContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Repite tu nueva contraseña"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#26332E"
                    android:textColorHint="#98A49F"
                    android:textSize="15sp" />

                <!-- =================================================
                     REQUISITOS
                     ================================================= -->

                <TextView
                    android:id="@+id/txtRequisitosContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="• Mínimo 8 caracteres&#10;• Usa letras y números&#10;• Evita contraseñas fáciles de adivinar"
                    android:textColor="#7A8580"
                    android:textSize="13sp" />

                <!-- =================================================
                     BOTON
                     ================================================= -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCambiarContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="Cambiar contraseña"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2E9B6F"
                    app:cornerRadius="10dp"
                    app:strokeWidth="0dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>