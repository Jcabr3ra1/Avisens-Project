<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notifTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notificaciones"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notifCerrar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Cerrar"
            android:padding="12dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/notifTodas"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Todas"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notifPendientes"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No leídas"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/notifLeerTodas"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="end|center_vertical"
        android:text="Marcar todas como leídas"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notifEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargando notificaciones…"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/notifScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/notifLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
