<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollOperarios"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- ============================== -->
            <!-- TÍTULO -->
            <!-- ============================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Gestión de operarios"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- ============================== -->
            <!-- DESCRIPCIÓN -->
            <!-- ============================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Administra tu equipo y las asignaciones de galpones"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- ============================== -->
            <!-- SEPARADOR -->
            <!-- ============================== -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#D7DEDA" />

            <!-- ============================== -->
            <!-- ACCIÓN CREAR -->
            <!-- ============================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Operarios de mi organización"
                    android:textColor="#1F5C42"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNuevoOperario"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="＋  Crear"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    app:backgroundTint="#2F8B5E"
                    app:strokeWidth="0dp"
                    app:cornerRadius="12dp"
                    app:elevation="0dp" />

            </LinearLayout>

            <!-- ============================== -->
            <!-- DESCRIPCIÓN DE LA LISTA -->
            <!-- ============================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Consulta sus datos y administra sus asignaciones"
                android:textColor="#89938E"
                android:textSize="11sp" />

            <!-- ============================== -->
            <!-- LISTA DE OPERARIOS -->
            <!-- ============================== -->

            <LinearLayout
                android:id="@+id/containerOperarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:clipToPadding="false"
                android:paddingBottom="20dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>