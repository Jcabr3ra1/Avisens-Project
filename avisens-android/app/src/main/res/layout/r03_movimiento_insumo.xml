<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_redondeado"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- TÍTULO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar entrada"
        android:textColor="@color/adaptive_text_171d1a"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- NOMBRE DEL INSUMO -->
    <TextView
        android:id="@+id/txtNombreMovimiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/adaptive_text_171d1a"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- STOCK ACTUAL -->
    <TextView
        android:id="@+id/txtStockMovimiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/adaptive_text_68736e"
        android:textSize="13sp" />

    <!-- CONTENIDO DESPLAZABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TIPO DE MOVIMIENTO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de movimiento: Entrada"
                android:textColor="@color/adaptive_text_176a4b"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- UNIDAD DE MEDIDA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Unidad de medida de la entrada"
                android:textColor="@color/adaptive_text_171d1a"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerUnidadMovimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_spinner_avisens"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:spinnerMode="dropdown" />

            <!-- CANTIDAD -->
            <TextView
                android:id="@+id/txtCantidadMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Cantidad a ingresar"
                android:textColor="@color/adaptive_text_171d1a"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtCantidadMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input_verde"
                android:hint="Ej. 100"
                android:inputType="numberDecimal"
                android:minHeight="52dp"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/adaptive_text_171d1a"
                android:textColorHint="@color/adaptive_text_68736e"
                android:textSize="15sp" />

            <!-- PESO POR BULTO -->
            <LinearLayout
                android:id="@+id/contenedorPesoBulto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Peso por bulto (kg)"
                    android:textColor="@color/adaptive_text_171d1a"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtPesoBulto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_verde"
                    android:hint="Ej. 40"
                    android:inputType="numberDecimal"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_171d1a"
                    android:textColorHint="@color/adaptive_text_68736e"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtAyudaBulto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/adaptive_text_68736e"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- VISTA PREVIA -->
            <TextView
                android:id="@+id/txtVistaPreviaMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_input_verde"
                android:gravity="center_vertical"
                android:minHeight="65dp"
                android:padding="12dp"
                android:text="Ingresa la cantidad para calcular el nuevo stock."
                android:textColor="@color/adaptive_text_176a4b"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarMovimiento"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/cancel_text"
            android:textSize="14sp"
            app:backgroundTint="@color/cancel_background"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarMovimiento"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Guardar entrada"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            app:backgroundTint="#18875A" />

    </LinearLayout>

</LinearLayout>