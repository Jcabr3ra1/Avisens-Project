<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/bg_dialog_white">

        <!-- ====================================== -->
        <!-- TITULO -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar evento"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="14dp"/>


        <!-- ====================================== -->
        <!-- TIPO DE EVENTO -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de evento"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- ================================== -->
            <!-- MURIÓ -->
            <!-- ================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEventoMurio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="♡&#10;Murió"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#B82F2F"
                android:backgroundTint="@color/white"
                android:gravity="center"
                app:cornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2C7C7"
                android:layout_marginEnd="5dp"/>


            <!-- ================================== -->
            <!-- ENFERMO -->
            <!-- ================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEventoEnfermo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="♧&#10;Enfermo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#66736D"
                android:backgroundTint="@color/white"
                android:gravity="center"
                app:cornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D6DED9"
                android:layout_marginStart="5dp"/>

        </LinearLayout>


        <!-- ====================================== -->
        <!-- CANTIDAD Y FECHA -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:weightSum="2">

            <!-- CANTIDAD -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad de aves"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/edtCantidadAves"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_event"
                    android:hint="Ej: 500"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="number"
                    android:singleLine="true"/>

            </LinearLayout>


            <!-- FECHA -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/edtFecha"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_event"
                    android:hint="30/06/2026"
                    android:textSize="13sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/black"
                    android:singleLine="true"
                    android:focusable="false"
                    android:clickable="true"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ====================================== -->
        <!-- CAUSA PROBABLE -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Causa probable"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerCausa"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:textColor="@color/black"
            android:background="@drawable/bg_input_event"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>


        <!-- ====================================== -->
        <!-- ZONA DEL GALPÓN -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zona del galpón"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- NORTE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZonaNorte"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Norte"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="#2E8B57"
                android:gravity="center"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="3dp"/>


            <!-- SUR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZonaSur"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Sur"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#66736D"
                android:backgroundTint="@color/white"
                android:gravity="center"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D6DED9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>


            <!-- ESTE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZonaEste"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Este"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#66736D"
                android:backgroundTint="@color/white"
                android:gravity="center"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D6DED9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>


            <!-- OESTE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZonaOeste"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Oeste"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#66736D"
                android:backgroundTint="@color/white"
                android:gravity="center"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D6DED9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="3dp"/>

        </LinearLayout>


        <!-- ====================================== -->
        <!-- OBSERVACIONES -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Observaciones"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edtObservaciones"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_observaciones"
            android:gravity="top|start"
            android:hint=""
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:inputType="textMultiLine"
            android:overScrollMode="ifContentScrolls"/>


        <!-- ====================================== -->
        <!-- EVIDENCIA -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Evidencia "
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(opcional)"
                android:textSize="12sp"
                android:textColor="#8A9690"/>

        </LinearLayout>


        <!-- ====================================== -->
        <!-- ADJUNTAR FOTO -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/btnAdjuntarFoto"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_evidence"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textSize="22sp"
                android:textColor="#8A9690"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjuntar foto"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8A9690"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


        <!-- ====================================== -->
        <!-- BOTONES -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <!-- CANCELAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarEvento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/white"
                android:gravity="center"
                app:cornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D6DED9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="4dp"/>


            <!-- GUARDAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEvento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Guardar registro"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="#2E8B57"
                android:gravity="center"
                app:cornerRadius="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>