<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/bg_dialog_white">

        <!-- ====================================== -->
        <!-- TITULO -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar evento"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="14dp" />

        <!-- ====================================== -->
        <!-- TIPO DE EVENTO -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de evento"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- ================================== -->
            <!-- MURIÓ -->
            <!-- ================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTipoMurio"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FDE7E7"
                app:cardCornerRadius="16dp"
                app:strokeColor="#FF3B30"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♡"
                        android:textSize="25sp"
                        android:textColor="#B3261E"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/txtTipoMurio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Murió"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#A61B16"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================================== -->
            <!-- ENFERMO -->
            <!-- ================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTipoEnfermo"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#F1F8F5"
                app:cardCornerRadius="16dp"
                app:strokeColor="#DCE8E2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♧"
                        android:textSize="27sp"
                        android:textColor="#718078"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/txtTipoEnfermo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enfermo"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#5F6B65"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ====================================== -->
        <!-- LOTE -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lote"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerLote"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input_event"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- ====================================== -->
        <!-- CANTIDAD Y FECHA -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:weightSum="2">

            <!-- CANTIDAD DE AVES -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad de aves"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtCantidadAves"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_event"
                    android:hint="Ej: 35"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="number"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- FECHA -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtFecha"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_event"
                    android:hint="27/08/2026"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:focusable="false"
                    android:clickable="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- ====================================== -->
        <!-- CAUSA PRESUNTIVA -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Causa presuntiva"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtCausaPresuntiva"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input_event"
            android:hint="Ej: sin determinar"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true" />

        <!-- ====================================== -->
        <!-- DISPOSICIÓN -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disposición"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtDisposicion"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input_event"
            android:hint="Opcional"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true" />

        <!-- ====================================== -->
        <!-- MÉTODO DE REGISTRO -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Método de registro"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerMetodoRegistro"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input_event"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- ====================================== -->
        <!-- OBSERVACIONES -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Observaciones"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtObservaciones"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_observaciones"
            android:gravity="top|start"
            android:hint="Escribe una observación..."
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:inputType="textMultiLine"
            android:overScrollMode="ifContentScrolls" />

        <!-- ====================================== -->
        <!-- BOTONES -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarEvento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="4dp"
                app:cornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D6DED9" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEvento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Guardar registro"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="#2E8B57"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="4dp"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>