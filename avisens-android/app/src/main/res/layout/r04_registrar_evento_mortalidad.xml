<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_dialog_white">

        <!-- TÍTULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar evento"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="10dp" />

        <!-- LOTE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lote"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="5dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_event">

            <Spinner
                android:id="@+id/spinnerLote"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </FrameLayout>

        <!-- TIPO DE EVENTO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de evento"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_event">

            <Spinner
                android:id="@+id/spinnerTipoEvento"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </FrameLayout>

        <!-- CANTIDAD + FECHA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:weightSum="2">

            <!-- CANTIDAD -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad de aves"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/edtCantidadAves"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_event"
                    android:hint="Ej: 35"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:inputType="number"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- FECHA -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/edtFecha"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_event"
                    android:hint="27/08/2026"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:focusable="false"
                    android:clickable="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- CAUSA PRESUNTIVA -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Causa presuntiva"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/edtCausaPresuntiva"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_event"
            android:hint="Ej: sin determinar"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true" />

        <!-- DISPOSICIÓN -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disposición"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/edtDisposicion"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_event"
            android:hint="Opcional"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true" />

        <!-- MÉTODO DE REGISTRO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Método de registro"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_event">

            <Spinner
                android:id="@+id/spinnerMetodoRegistro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </FrameLayout>

        <!-- OBSERVACIONES -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Observaciones"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/edtObservaciones"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_observaciones"
            android:gravity="top|start"
            android:hint="Escribe una observación..."
            android:padding="10dp"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:inputType="textMultiLine"
            android:overScrollMode="ifContentScrolls" />

        <!-- BOTONES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <!-- CANCELAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarEvento"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="3dp"
                app:cornerRadius="9dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D6DED9" />

            <!-- GUARDAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEvento"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Guardar registro"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="#2E8B57"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="3dp"
                app:cornerRadius="9dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>