<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_white"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Registrar mortalidad"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- LOTE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="Lote"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_event">

            <Spinner
                android:id="@+id/spinnerLote"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:dropDownWidth="match_parent"
                android:dropDownHorizontalOffset="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:popupBackground="@drawable/bg_spinner_dropdown" />

        </FrameLayout>

        <!-- CANTIDAD Y FECHA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- CANTIDAD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Cantidad de aves"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCantidadAves"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_event"
                    android:fontFamily="sans-serif-medium"
                    android:hint="Ej: 35"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_000000"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- FECHA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Fecha"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtFecha"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_event"
                    android:clickable="true"
                    android:focusable="false"
                    android:fontFamily="sans-serif-medium"
                    android:hint="27/08/2026"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_000000"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- CAUSA PRESUNTIVA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:text="Causa presuntiva"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerCausaPresuntiva"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_spinner_bitacora"
            android:dropDownWidth="match_parent"
            android:popupBackground="@drawable/bg_spinner_dropdown" />

        <EditText
            android:id="@+id/edtCausaPresuntiva"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_event"
            android:fontFamily="sans-serif-medium"
            android:hint="Especificar otra causa"
            android:maxLength="150"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/adaptive_text_000000"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- OBSERVACIONES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:text="Observaciones"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtObservaciones"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_observaciones"
            android:fontFamily="sans-serif-medium"
            android:gravity="top|start"
            android:hint="Escribe una observación..."
            android:inputType="textMultiLine"
            android:overScrollMode="ifContentScrolls"
            android:padding="10dp"
            android:textColor="@color/adaptive_text_000000"
            android:textSize="13sp" />

        <!-- EVIDENCIA FOTOGRÁFICA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Evidencia (opcional)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- RECUADRO INICIAL PARA ADJUNTAR FOTO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTomarFotoMortalidad"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/adaptive_surface_ffffff"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Adjuntar foto"
            android:textAllCaps="false"
            android:textColor="@color/adaptive_text_7d8985"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_camera_evidencia"
            app:iconGravity="textTop"
            app:iconPadding="8dp"
            app:iconSize="26dp"
            app:iconTint="@color/adaptive_text_7d8985"
            app:strokeColor="#E4EAE7"
            app:strokeWidth="1dp" />

        <!-- FOTOGRAFÍA CON CONTROLES SUPERPUESTOS -->
        <FrameLayout
            android:id="@+id/contenedorFotoMortalidad"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_foto_mortalidad"
            android:clipToOutline="true"
            android:visibility="gone">

            <!-- FOTOGRAFÍA OCUPANDO TODO EL RECUADRO -->
            <ImageView
                android:id="@+id/imgFotoMortalidad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/adaptive_surface_f4f7f5"
                android:clickable="true"
                android:contentDescription="Vista previa de la fotografía"
                android:focusable="true"
                android:scaleType="centerCrop" />

            <!-- FRANJA OSCURA SEMITRANSPARENTE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="bottom"
                android:background="#66000000"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- AMPLIAR FOTOGRAFÍA -->
                <LinearLayout
                    android:id="@+id/btnAmpliarFotoMortalidad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="Ampliar fotografía"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Icono ampliar"
                        android:src="@drawable/ic_ampliar_foto_mortalidad"
                        android:tint="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Ampliar"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- SEPARADOR -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#66FFFFFF" />

                <!-- ELIMINAR FOTOGRAFÍA -->
                <LinearLayout
                    android:id="@+id/btnEliminarFotoMortalidad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="Eliminar fotografía"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Icono eliminar"
                        android:src="@drawable/ic_eliminar_foto_mortalidad"
                        android:tint="#FFB5B5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Eliminar"
                        android:textColor="#FFB5B5"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- BOTONES DEL FORMULARIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- CANCELAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarEvento"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="@color/cancel_text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/cancel_background"
                app:cornerRadius="9dp"
                app:strokeColor="@color/cancel_stroke"
                app:strokeWidth="1dp" />

            <!-- GUARDAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEvento"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:backgroundTint="#2E8B57"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Guardar registro"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="9dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>