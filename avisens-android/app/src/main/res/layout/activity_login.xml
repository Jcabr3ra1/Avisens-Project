<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F5"
    tools:context=".ui.LoginActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ========================================================= -->
            <!-- FONDO DEL HERO                                            -->
            <!-- ========================================================= -->

            <View
                android:id="@+id/heroBackground"
                android:layout_width="0dp"
                android:layout_height="550dp"
                android:background="@drawable/bg_hero_login"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ========================================================= -->
            <!-- ILUSTRACIÓN DE FONDO                                      -->
            <!-- ========================================================= -->

            <ImageView
                android:id="@+id/imgHeroIlustracion"
                android:layout_width="0dp"
                android:layout_height="550dp"
                android:alpha="0.60"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ilustracion_granja"
                app:layout_constraintTop_toTopOf="@id/heroBackground"
                app:layout_constraintBottom_toBottomOf="@id/heroBackground"
                app:layout_constraintStart_toStartOf="@id/heroBackground"
                app:layout_constraintEnd_toEndOf="@id/heroBackground" />

            <!-- ========================================================= -->
            <!-- CAPA OSCURA SOBRE LA ILUSTRACIÓN                          -->
            <!-- ========================================================= -->

            <View
                android:id="@+id/darkOverlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@id/heroBackground"
                app:layout_constraintBottom_toBottomOf="@id/heroBackground"
                app:layout_constraintStart_toStartOf="@id/heroBackground"
                app:layout_constraintEnd_toEndOf="@id/heroBackground" />

            <!-- ========================================================= -->
            <!-- LOGO                                                       -->
            <!-- ========================================================= -->

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="55dp"
                android:contentDescription="Logo Avisens"
                android:src="@drawable/logo_avisens"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- ========================================================= -->
            <!-- NOMBRE DE LA APLICACIÓN                                    -->
            <!-- ========================================================= -->

            <TextView
                android:id="@+id/txtNombreApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="AVISENS"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:layout_constraintTop_toTopOf="@id/imgLogo"
                app:layout_constraintBottom_toBottomOf="@id/imgLogo"
                app:layout_constraintStart_toEndOf="@id/imgLogo" />

            <!-- ========================================================= -->
            <!-- TÍTULO HERO                                                -->
            <!-- ========================================================= -->

            <TextView
                android:id="@+id/txtHeroTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="45dp"
                android:layout_marginEnd="20dp"
                android:lineSpacingExtra="2dp"
                android:text="Tu granja,\nsiempre bajo control."
                android:textColor="@android:color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ========================================================= -->
            <!-- TARJETA DE INGRESO                                         -->
            <!-- ========================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_login_card_elevated"
                android:elevation="8dp"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@id/txtHeroTitulo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- ===================================================== -->
                <!-- ENCABEZADO                                             -->
                <!-- ===================================================== -->

                <TextView
                    android:id="@+id/txtEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—  INGRESO SEGURO"
                    android:textColor="#1E9E63"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txtIniciarSesion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Bienvenido a AVISENS"
                    android:textColor="#0E2A20"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/txtEyebrow"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txtSubtitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ingresa con tu cuenta para supervisar tu granja en tiempo real."
                    android:textColor="#5A6E66"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/txtIniciarSesion"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- ===================================================== -->
                <!-- CORREO                                                 -->
                <!-- ===================================================== -->

                <TextView
                    android:id="@+id/txtCorreo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Correo electrónico"
                    android:textColor="#2E3B36"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/txtSubtitulo"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_input_lavender"
                    android:contentDescription="Campo de correo electrónico"
                    android:hint="operario@avisens.com"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:paddingStart="44dp"
                    android:paddingEnd="12dp"
                    android:textColor="#1B2B26"
                    android:textColorHint="#009688"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/txtCorreo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Icono correo -->

                <ImageView
                    android:id="@+id/iconCorreo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_email"
                    app:tint="#009688"
                    app:layout_constraintTop_toTopOf="@id/etCorreo"
                    app:layout_constraintBottom_toBottomOf="@id/etCorreo"
                    app:layout_constraintStart_toStartOf="@id/etCorreo" />

                <!-- ===================================================== -->
                <!-- CONTRASEÑA                                             -->
                <!-- ===================================================== -->

                <TextView
                    android:id="@+id/txtContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Contraseña"
                    android:textColor="#2E3B36"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/etCorreo"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_input_lavender"
                    android:contentDescription="Campo de contraseña"
                    android:hint="Ingresa tu contraseña"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="44dp"
                    android:paddingEnd="44dp"
                    android:textColor="#1B2B26"
                    android:textColorHint="#009688"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/txtContrasena"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Icono contraseña -->

                <ImageView
                    android:id="@+id/iconContrasena"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="#009688"
                    app:layout_constraintTop_toTopOf="@id/etContrasena"
                    app:layout_constraintBottom_toBottomOf="@id/etContrasena"
                    app:layout_constraintStart_toStartOf="@id/etContrasena" />

                <!-- Mostrar / ocultar contraseña -->

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar u ocultar contraseña"
                    android:src="@drawable/ic_eye_off"
                    app:tint="#009688"
                    app:layout_constraintTop_toTopOf="@id/etContrasena"
                    app:layout_constraintBottom_toBottomOf="@id/etContrasena"
                    app:layout_constraintEnd_toEndOf="@id/etContrasena" />

                <!-- ===================================================== -->
                <!-- RECORDAR / OLVIDÉ MI CONTRASEÑA                        -->
                <!-- ===================================================== -->

                <CheckBox
                    android:id="@+id/checkRecordarme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="40dp"
                    android:buttonTint="#1E9E63"
                    android:text="Recordarme"
                    android:textColor="#4A5D55"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/etContrasena"
                    app:layout_constraintStart_toStartOf="parent"/>


                <!-- ===================================================== -->
                <!-- BOTÓN MATERIAL                                         -->
                <!-- ===================================================== -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEntrar"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_gradient_green"
                    android:stateListAnimator="@null"
                    android:text="Entrar a mi granja"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="12dp"
                    app:rippleColor="#33FFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/checkRecordarme"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- ===================================================== -->
                <!-- INDICADOR DE CARGA                                     -->
                <!-- ===================================================== -->

                <ProgressBar
                    android:id="@+id/progressLogin"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/btnEntrar"
                    app:layout_constraintBottom_toBottomOf="@id/btnEntrar"
                    app:layout_constraintStart_toStartOf="@id/btnEntrar"
                    app:layout_constraintEnd_toEndOf="@id/btnEntrar" />

                <!-- ===================================================== -->
                <!-- MENSAJE DE ERROR                                       -->
                <!-- ===================================================== -->

                <TextView
                    android:id="@+id/txtError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/btnEntrar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>