<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/lotePesaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargando lote…"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/estadoPesaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="@color/text_primary"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bitacora_card"
        android:padding="12dp"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/resumenPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Último peso: —"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/objetivoPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peso objetivo: —"
            android:textSize="16sp"
            android:textColor="@color/text_primary"/>
        <com.project.avisensandroid.ui.fragments.GraficaPesajes
            android:id="@+id/graficaPeso"
            android:layout_width="match_parent"
            android:layout_height="220dp"/>
        <TextView
            android:id="@+id/leyendaPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verde: real · Gris: objetivo · Rojo: desvío mayor al 7 %"
            android:textSize="12sp"
            android:textColor="@color/text_primary"/>
        <TextView
            android:id="@+id/desvioPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>
    <TextView
        android:id="@+id/registrarPeso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Registrar pesaje"
        android:textSize="15sp"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_bitacora_button"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginTop="12dp"/>
    <TextView
        android:id="@+id/tituloHistorialPeso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial de pesajes"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="18dp"
        android:textStyle="bold"/>
    <LinearLayout
        android:id="@+id/listaPeso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
</LinearLayout>
