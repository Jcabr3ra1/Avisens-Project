<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_guia_card">
    <TextView
        android:id="@+id/ciclo"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ciclo de crianza"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/guiaCurvaPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">
        <TextView
            android:id="@+id/estadoCurva"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Consultando curva…"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        <Spinner
            android:id="@+id/metrica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <com.project.avisensandroid.ui.fragments.GraficaCrecimiento
            android:id="@+id/grafica"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp" />
        <TextView
            android:id="@+id/detalleCurva"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reintentar"

            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Actualizar curva"
            app:backgroundTint="@color/green_button"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="9dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/comparar"

            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Comparar lotes"
            app:backgroundTint="@color/green_button"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="9dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/guiaSimPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simular fecha de salida"
            android:textSize="17sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estima el peso, la conversión y el alimento sin modificar el plan actual."
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Se necesitan tres pesajes en días distintos."
            android:textSize="13sp"
            android:textColor="@color/text_primary"

            android:id="@+id/avisoSimGuia" />
        <TextView
            android:id="@+id/etapas"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone" />
        <EditText
            android:id="@+id/diaSimulado"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Día de salida (1–100)"
            android:inputType="number"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/guia_64736b"
            android:background="@drawable/bg_guia_input"
            android:padding="12dp"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/simular"

            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Simular salida"
            app:backgroundTint="@color/green_button"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:enabled="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="9dp" />
        <TextView
            android:id="@+id/resultadoSim"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/guiaReportPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/csv"

            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Exportar CSV de crecimiento"
            app:backgroundTint="@color/green_button"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="9dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/csvAlimento"

            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Exportar CSV de alimentación"
            app:backgroundTint="@color/green_button"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="9dp" />
    </LinearLayout>
</LinearLayout>
