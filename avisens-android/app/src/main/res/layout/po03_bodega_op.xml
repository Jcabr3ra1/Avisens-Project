<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- ============================= -->
    <!-- CONTENIDO -->
    <!-- ============================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBodega"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:layout_marginTop="8dp"
            android:paddingEnd="17dp"
            android:paddingTop="17dp"
            android:paddingBottom="20dp">

            <!-- ============================= -->
            <!-- TÍTULO -->
            <!-- ============================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bodega e Inventario"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:layout_marginTop="22dp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Stock de insumos y directorio de proveedores"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>


            <!-- ============================= -->
            <!-- INDICADORES -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- CRÍTICO -->

                <TextView
                    android:id="@+id/txtCriticos"
                    android:layout_width="wrap_content"
                    android:layout_height="27dp"
                    android:background="@drawable/bg_bodega_critico"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:text="● 1 crítico"
                    android:textColor="#C93B32"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ============================= -->
            <!-- SELECTOR INSUMOS / PROVEEDORES -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/tabsBodega"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_bodega_tabs"
                android:padding="4dp"
                android:orientation="horizontal">

                <!-- INSUMOS -->

                <TextView
                    android:id="@+id/btnInsumos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bodega_tab_selected"
                    android:gravity="center"
                    android:text="⬡ Insumos"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <!-- PROVEEDORES -->

                <TextView
                    android:id="@+id/btnProveedores"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="♧ Proveedores"
                    android:textColor="#89938E"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ============================= -->
            <!-- BOTÓN NUEVO INSUMO -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="10dp">


                <TextView
                    android:id="@+id/btnNuevoInsumo"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bodega_nuevo"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="+ Nuevo Insumo"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    android:textStyle="bold"/>


            </LinearLayout>


            <!-- ============================= -->
            <!-- TARJETA 1 -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/cardConcentrado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_bodega_card"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- NOMBRE + TIPO -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Concentrado Engorde Fase 2"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="21dp"
                        android:background="@drawable/bg_bodega_tipo"
                        android:gravity="center"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="alimento"
                        android:textColor="#7D8782"
                        android:textSize="10sp"/>

                </LinearLayout>


                <!-- CANTIDAD -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtCantidadAlimento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1,200"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="3dp"
                        android:text="kg"
                        android:textColor="#89938E"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- BARRA STOCK -->

                <ProgressBar
                    android:id="@+id/progressAlimento"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="90"
                    android:progressTint="#22965F"
                    android:backgroundTint="#E8ECEA"/>


                <!-- INFO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Mínimo: 500 kg  Autonomía: 18 días"
                    android:textColor="#89938E"
                    android:textSize="11sp"/>


                <!-- PROVEEDOR + ESTADO -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Italcol S.A."
                        android:textColor="#69746F"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtStockOk"
                        android:layout_width="wrap_content"
                        android:layout_height="23dp"
                        android:background="@drawable/bg_stock_ok"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Stock OK"
                        android:textColor="#18875A"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ============================= -->
            <!-- TARJETA 2 -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/cardVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_bodega_card_critico"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- NOMBRE + TIPO -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vacuna Newcastle\n(IB)"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="21dp"
                        android:background="@drawable/bg_bodega_tipo"
                        android:gravity="center"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="vacuna"
                        android:textColor="#7D8782"
                        android:textSize="10sp"/>

                </LinearLayout>


                <!-- CANTIDAD -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtCantidadVacuna"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="3dp"
                        android:text="dosis"
                        android:textColor="#89938E"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- BARRA STOCK CRÍTICA -->

                <ProgressBar
                    android:id="@+id/progressVacuna"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="20"
                    android:progressTint="#E85A4F"
                    android:backgroundTint="#E8ECEA"/>


                <!-- INFO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Mínimo: 100 dosis  Autonomía: 3 días"
                    android:textColor="#89938E"
                    android:textSize="11sp"/>


                <!-- PROVEEDOR + ESTADO -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MSD Animal Health"
                        android:textColor="#69746F"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtStockCritico"
                        android:layout_width="wrap_content"
                        android:layout_height="23dp"
                        android:background="@drawable/bg_stock_critico"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Stock crítico"
                        android:textColor="#C93B32"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ============================= -->
    <!-- BARRA DE NAVEGACIÓN -->
    <!-- ============================= -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>