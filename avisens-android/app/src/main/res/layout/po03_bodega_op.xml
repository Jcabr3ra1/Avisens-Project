<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- ===================================================== -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBodega"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:paddingTop="17dp"
            android:paddingBottom="20dp">

            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Bodega e Inventario"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Stock de insumos y directorio de proveedores"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- ================================================= -->
            <!-- INDICADOR DE INSUMOS CRÍTICOS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCriticos"
                    android:layout_width="wrap_content"
                    android:layout_height="27dp"
                    android:background="@drawable/bg_bodega_critico"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:text="● 0 críticos"
                    android:textColor="#C93B32"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- SELECTOR INSUMOS / PROVEEDORES -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/tabsBodega"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_bodega_tabs"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- INSUMOS -->

                <TextView
                    android:id="@+id/btnInsumos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bodega_tab_selected"
                    android:gravity="center"
                    android:text="⬡ Insumos"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- PROVEEDORES -->

                <TextView
                    android:id="@+id/btnProveedores"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="♧ Proveedores"
                    android:textColor="#89938E"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- BOTÓN NUEVO INSUMO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end">

                <TextView
                    android:id="@+id/btnNuevoInsumo"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bodega_nuevo"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="+ Nuevo Insumo"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- INDICADOR DE CARGA -->
            <!-- ================================================= -->

            <ProgressBar
                android:id="@+id/progressInsumos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="25dp"
                android:visibility="gone" />

            <!-- ================================================= -->
            <!-- CONTENEDOR DINÁMICO DE INSUMOS -->
            <!-- ================================================= -->
            <!--
                IMPORTANTE:

                Aquí BodegaFragment agregará las tarjetas
                obtenidas desde:

                GET /v1/insumos

                No colocar tarjetas manualmente aquí.
            -->

            <LinearLayout
                android:id="@+id/contenedorInsumos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- ================================================= -->
            <!-- MENSAJE SIN INSUMOS -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtSinInsumos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:padding="20dp"
                android:text="No hay insumos registrados"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>