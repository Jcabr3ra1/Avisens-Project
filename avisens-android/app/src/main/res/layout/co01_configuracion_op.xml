<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4EF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- ========================================= -->
        <!-- CERRAR -->
        <!-- ========================================= -->

        <ImageButton
            android:id="@+id/btnCerrarConfiguracion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Cerrar configuración"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            app:tint="#66736D" />

        <!-- ========================================= -->
        <!-- TITULO -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configuración"
            android:textColor="#18231F"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Administra las preferencias de tu cuenta"
            android:textColor="#66736D"
            android:textSize="13sp" />

        <!-- ========================================= -->
        <!-- PREFERENCIAS -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="PREFERENCIAS"
            android:textColor="#89948F"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- ========================================= -->
        <!-- ALERTAS -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/btnConfiguracionNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_white"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_config">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="Alertas"
                    android:src="@drawable/ic_notifications"
                    app:tint="#188B60" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notificaciones"
                    android:textColor="#26332E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Configura las alertas de tus galpones"
                    android:textColor="#89948F"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#188B60"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================= -->
        <!-- CUENTA -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="CUENTA"
            android:textColor="#89948F"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- ========================================= -->
        <!-- PERFIL -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/btnConfiguracionPerfil"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_white"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_config">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="Perfil"
                    android:src="@drawable/ic_person_outline"
                    app:tint="#188B60" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Perfil"
                    android:textColor="#26332E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Administra tu información personal"
                    android:textColor="#89948F"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#188B60"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================= -->
        <!-- SEGURIDAD -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/btnConfiguracionSeguridad"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_white"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_config">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="Seguridad"
                    android:src="@drawable/ic_security"
                    app:tint="#188B60" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seguridad"
                    android:textColor="#26332E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Protege y administra el acceso a tu cuenta"
                    android:textColor="#89948F"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#188B60"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================= -->
        <!-- CERRAR SESIÓN -->
        <!-- ========================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="#B82F2F"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FCECEC"
            app:cornerRadius="10dp"
            app:strokeColor="#E8BDBD"
            app:strokeWidth="1dp" />

        <!-- ========================================= -->
        <!-- MARCA -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:gravity="center"
            android:text="Avisens"
            android:textColor="#188B60"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="Gestión inteligente para tu producción avícola"
            android:textColor="#A0AAA5"
            android:textSize="10sp" />

    </LinearLayout>

</ScrollView>