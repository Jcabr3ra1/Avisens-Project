<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- ============================== -->
    <!-- CONTENIDO -->
    <!-- ============================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollProveedores"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:paddingTop="17dp"
            android:layout_marginTop="8dp"
            android:paddingBottom="20dp">

            <!-- ============================== -->
            <!-- TÍTULO -->
            <!-- ============================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bodega e Inventario"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:layout_marginTop="20dp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Stock de insumos y directorio de proveedores"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>


            <!-- ============================== -->
            <!-- INDICADORES -->
            <!-- ============================== -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCriticos"
                    android:layout_width="wrap_content"
                    android:layout_height="27dp"
                    android:background="@drawable/bg_bodega_critico"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:text="● 1 crítico"
                    android:textColor="#C93B32"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtBajos"
                    android:layout_width="wrap_content"
                    android:layout_height="27dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_bodega_bajo"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:text="● 1 bajo"
                    android:textColor="#B47A17"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ============================== -->
            <!-- SELECTOR -->
            <!-- ============================== -->

            <LinearLayout
                android:id="@+id/tabsBodega"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_bodega_tabs"
                android:padding="4dp"
                android:orientation="horizontal">

                <!-- INSUMOS -->

                <TextView
                    android:id="@+id/btnInsumos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⬡ Insumos"
                    android:textColor="#89938E"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <!-- PROVEEDORES SELECCIONADO -->

                <TextView
                    android:id="@+id/btnProveedores"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bodega_tab_selected"
                    android:gravity="center"
                    android:text="♧ Proveedores"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ============================== -->
            <!-- PROVEEDORES DINÁMICOS -->
            <!-- ============================== -->

            <LinearLayout
                android:id="@+id/contenedorProveedores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>