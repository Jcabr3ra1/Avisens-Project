<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- ============================== -->
    <!-- CONTENIDO -->
    <!-- ============================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollProveedores"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:paddingTop="17dp"
            android:layout_marginTop="8dp"
            android:paddingBottom="20dp">

            <!-- ============================== -->
            <!-- TÍTULO -->
            <!-- ============================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bodega e Inventario"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:layout_marginTop="20dp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Stock de insumos y directorio de proveedores"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>


            <!-- ============================== -->
            <!-- INDICADORES -->
            <!-- ============================== -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCriticos"
                    android:layout_width="wrap_content"
                    android:layout_height="27dp"
                    android:background="@drawable/bg_bodega_critico"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:text="● 1 crítico"
                    android:textColor="#C93B32"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtBajos"
                    android:layout_width="wrap_content"
                    android:layout_height="27dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_bodega_bajo"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:text="● 1 bajo"
                    android:textColor="#B47A17"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ============================== -->
            <!-- SELECTOR -->
            <!-- ============================== -->

            <LinearLayout
                android:id="@+id/tabsBodega"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_bodega_tabs"
                android:padding="4dp"
                android:orientation="horizontal">

                <!-- INSUMOS -->

                <TextView
                    android:id="@+id/btnInsumos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⬡ Insumos"
                    android:textColor="#89938E"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <!-- PROVEEDORES SELECCIONADO -->

                <TextView
                    android:id="@+id/btnProveedores"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bodega_tab_selected"
                    android:gravity="center"
                    android:text="♧ Proveedores"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ============================== -->
            <!-- PROVEEDOR 1 -->
            <!-- ============================== -->

            <LinearLayout
                android:id="@+id/cardItalcol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_bodega_provider_card"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- NOMBRE -->

                <TextView
                    android:id="@+id/txtProveedorItalcol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Italcol S.A."
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- CONTACTO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Jorge Medina · 311-450-2030"
                    android:textColor="#89938E"
                    android:textSize="10sp"/>

                <!-- NIT -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="NIT: 860.002.626-5"
                    android:textColor="#69746F"
                    android:textSize="10sp"/>

                <!-- DESCRIPCIÓN -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="1dp"
                    android:text="Concentrados y alimentos para&#10;aves de engorde"
                    android:textColor="#89938E"
                    android:textSize="10sp"/>


                <!-- ============================== -->
                <!-- CALIFICACIONES -->
                <!-- ============================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="vertical">

                    <!-- CUMPLIMIENTO -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="95dp"
                            android:layout_height="wrap_content"
                            android:text="Cumplimiento"
                            android:textColor="#89938E"
                            android:textSize="10sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★★"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <!-- CALIDAD -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="95dp"
                            android:layout_height="wrap_content"
                            android:text="Calidad"
                            android:textColor="#89938E"
                            android:textSize="10sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★★"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <!-- ENTREGA -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="95dp"
                            android:layout_height="wrap_content"
                            android:text="Entrega"
                            android:textColor="#89938E"
                            android:textSize="10sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★☆"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- ESTADO -->

                <TextView
                    android:id="@+id/txtExcelente"
                    android:layout_width="74dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_provider_excellent"
                    android:gravity="center"
                    android:text="● Excelente"
                    android:textColor="#18875A"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ============================== -->
            <!-- PROVEEDOR 2 -->
            <!-- ============================== -->

            <LinearLayout
                android:id="@+id/cardMsd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_bodega_provider_card"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- NOMBRE -->

                <TextView
                    android:id="@+id/txtProveedorMsd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MSD Animal Health"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- CONTACTO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Claudia Torres · 320-300-4050"
                    android:textColor="#89938E"
                    android:textSize="10sp"/>

                <!-- NIT -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="NIT: 900.123.456-1"
                    android:textColor="#69746F"
                    android:textSize="10sp"/>

                <!-- DESCRIPCIÓN -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="1dp"
                    android:text="Vacunas y biológicos para&#10; avicultura"
                    android:textColor="#89938E"
                    android:textSize="10sp"/>


                <!-- ============================== -->
                <!-- CALIFICACIONES -->
                <!-- ============================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="vertical">

                    <!-- CUMPLIMIENTO -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="95dp"
                            android:layout_height="wrap_content"
                            android:text="Cumplimiento"
                            android:textColor="#89938E"
                            android:textSize="10sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★☆"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <!-- CALIDAD -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="95dp"
                            android:layout_height="wrap_content"
                            android:text="Calidad"
                            android:textColor="#89938E"
                            android:textSize="10sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★★"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <!-- ENTREGA -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="95dp"
                            android:layout_height="wrap_content"
                            android:text="Entrega"
                            android:textColor="#89938E"
                            android:textSize="10sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★☆"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- ESTADO -->

                <TextView
                    android:id="@+id/txtRegular"
                    android:layout_width="64dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_provider_regular"
                    android:gravity="center"
                    android:text="● Regular"
                    android:textColor="#B47A17"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ============================== -->
    <!-- BARRA DE NAVEGACIÓN -->
    <!-- ============================== -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>