<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4EF">

    <!-- =====================================================
         CONTENIDO PRINCIPAL
         ===================================================== -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- =================================================
                 BOTÓN ATRÁS
                 ================================================= -->

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_spinner_granja"
                android:contentDescription="Volver"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#145C42" />

            <!-- =================================================
                 TÍTULO
                 ================================================= -->

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recuperacion_titulo"
                android:textColor="#17231F"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- =================================================
                 DESCRIPCIÓN
                 ================================================= -->

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/recuperacion_descripcion"
                android:textColor="#66736D"
                android:textSize="16sp" />

            <!-- =================================================
                 TARJETA DEL FORMULARIO
                 ================================================= -->

            <LinearLayout
                android:id="@+id/formularioRecuperacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/edtUsuario"
                    android:text="@string/recuperacion_usuario"
                    android:textColor="#26332E"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:autofillHints="username"
                    android:hint="@string/recuperacion_usuario_ejemplo"
                    android:inputType="text|textNoSuggestions"
                    android:maxLength="30"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#26332E"
                    android:textColorHint="#98A49F"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="#B3261E"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- BOTÓN -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnviarSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/recuperacion_enviar"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2E9B6F"
                    app:cornerRadius="10dp"
                    app:strokeWidth="0dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtConfirmacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:textColor="#17231F"
                android:textSize="16sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverLogin"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/recuperacion_volver_login"
                android:textAllCaps="false"
                android:textColor="#145C42"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
