<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adaptive_surface_f4f6f5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_login_card_elevated"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imgRecuperacion"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:padding="16dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/adaptive_text_00695c" />

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Recuperar contraseña"
                android:textColor="@color/adaptive_text_00695c"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Envía una solicitud al administrador para recuperar el acceso a tu cuenta."
                android:textColor="@color/adaptive_text_426058"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtCampoUno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Nombre de usuario"
                android:textColor="@color/adaptive_text_17211d"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_lavender"
                android:hint="Ingresa tu usuario"
                android:inputType="textNoSuggestions"
                android:maxLength="30"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:saveEnabled="false"
                android:textColor="@color/adaptive_text_17211d"
                android:textColorHint="@color/adaptive_text_4a5d55"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtCampoDos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Motivo de la solicitud"
                android:textColor="@color/adaptive_text_17211d"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtMotivo"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_lavender"
                android:gravity="top|start"
                android:hint="Describe el motivo de tu solicitud..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:padding="14dp"
                android:saveEnabled="false"
                android:textColor="@color/adaptive_text_17211d"
                android:textColorHint="@color/adaptive_text_4a5d55"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarSolicitud"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_gradient_green"
                android:text="Enviar solicitud"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="12dp" />

            <ProgressBar
                android:id="@+id/progreso"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/adaptive_text_d32f2f"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtVolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="Volver al inicio"
                android:textColor="@color/adaptive_text_00695c"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
