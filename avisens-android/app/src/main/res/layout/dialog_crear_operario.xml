<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical">

    <!-- CONTENIDO DESPLAZABLE -->

    <ScrollView
        android:id="@+id/scrollCrearOperario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear operario"
                android:textColor="@color/adaptive_text_151515"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Completa los datos para registrar un nuevo operario."
                android:textColor="@color/adaptive_text_7a817d"
                android:textSize="14sp" />

            <!-- DATOS PERSONALES -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Datos personales"
                android:textColor="@color/adaptive_text_1f5c42"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- NOMBRE COMPLETO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Nombre completo"
                android:textColor="@color/adaptive_text_202020"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_form"
                android:minHeight="52dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombreOperario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Ej. Juan Pérez"
                    android:inputType="textCapWords"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_1f2924"
                    android:textColorHint="@color/adaptive_text_75847c"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CÉDULA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Cédula"
                android:textColor="@color/adaptive_text_202020"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_form"
                android:minHeight="52dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCedulaOperario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Ej. 1234567890"
                    android:inputType="number"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_1f2924"
                    android:textColorHint="@color/adaptive_text_75847c"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CORREO ELECTRÓNICO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Correo electrónico"
                android:textColor="@color/adaptive_text_202020"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_form"
                android:minHeight="52dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmailOperario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Ej. correo@ejemplo.com"
                    android:inputType="textEmailAddress"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_1f2924"
                    android:textColorHint="@color/adaptive_text_75847c"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- TELÉFONO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Teléfono"
                android:textColor="@color/adaptive_text_202020"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_form"
                android:minHeight="52dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefonoOperario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Ej. 3001234567"
                    android:inputType="phone"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_1f2924"
                    android:textColorHint="@color/adaptive_text_75847c"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- SEPARADOR -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="@color/adaptive_surface_dde5e0" />

            <!-- CREDENCIALES -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Credenciales de acceso"
                android:textColor="@color/adaptive_text_1f5c42"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Datos para iniciar sesión."
                android:textColor="@color/adaptive_text_7a817d"
                android:textSize="14sp" />

            <!-- NOMBRE DE USUARIO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Nombre de usuario"
                android:textColor="@color/adaptive_text_202020"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_form"
                android:minHeight="52dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsernameOperario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Ej. juanperez"
                    android:inputType="textNoSuggestions"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_1f2924"
                    android:textColorHint="@color/adaptive_text_75847c"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CONTRASEÑA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Contraseña"
                android:textColor="@color/adaptive_text_202020"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_form"
                android:minHeight="52dp"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordOperario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Ingresa una contraseña"
                    android:inputType="textPassword"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_1f2924"
                    android:textColorHint="@color/adaptive_text_75847c"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CONFIRMAR CONTRASEÑA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Confirmar contraseña"
                android:textColor="@color/adaptive_text_202020"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_form"
                android:minHeight="52dp"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmarPasswordOperario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Repite la contraseña"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/adaptive_text_1f2924"
                    android:textColorHint="@color/adaptive_text_75847c"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BOTONES FIJOS EN LA PARTE INFERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarOperario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/cancel_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cancel_background"
            app:cornerRadius="10dp"
            app:strokeColor="@color/cancel_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearOperario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:text="Crear"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:backgroundTint="#2F8B5E"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>