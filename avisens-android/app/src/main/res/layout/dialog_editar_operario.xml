<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_gestion_operario"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editar operario"
        android:textColor="#183C2E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNombreEditarOperario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#2F8B5E"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDatosEditarOperario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#78847E"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="#E7EEE9" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchUsuarioActivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usuario activo"
        android:textColor="#183C2E"
        android:textSize="14sp"
        android:textStyle="bold"
        app:useMaterialThemeColors="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Granjas asignadas"
        android:textColor="#1F5C42"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerGranjasEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Asignar nueva granja"
        android:textColor="#1F5C42"
        android:textSize="14sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_input_verde"
        android:padding="0dp">

        <Spinner
            android:id="@+id/spinnerGranjasEditar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:popupBackground="@drawable/bg_spinner_dropdown"
            android:spinnerMode="dropdown" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarEditarOperario"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#171D1A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_boton_cancelar"
            app:backgroundTint="@null"
            app:cornerRadius="9dp"
            app:rippleColor="#E8F3ED"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarEditarOperario"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:text="Guardar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#2F8B5E"
            app:cornerRadius="9dp"
            app:rippleColor="#245F42"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</LinearLayout>
