<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_gestion_galpon"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="24dp"
    android:paddingEnd="32dp"
    android:paddingBottom="22dp">

    <!-- ========================================== -->
    <!-- TÍTULO -->
    <!-- ========================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="Gestión Galpón"
        android:textColor="@color/adaptive_text_18211d"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- ========================================== -->
    <!-- NOMBRE GALPÓN -->
    <!-- ========================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Nombre Galpón"
        android:textColor="@color/adaptive_text_18211d"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtNombreGalpon"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_input_galpon"
        android:fontFamily="sans-serif-medium"
        android:hint="Ej: Granja Kotlin"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/adaptive_text_000000"
        android:textColorHint="@color/adaptive_text_91a09a"
        android:textSize="12sp" />

    <!-- ========================================== -->
    <!-- CANTIDAD POLLOS -->
    <!-- ========================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Cantidad Pollos"
        android:textColor="@color/adaptive_text_18211d"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtCantidadPollos"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_input_galpon"
        android:fontFamily="sans-serif-medium"
        android:hint="Ej: 500"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/adaptive_text_000000"
        android:textColorHint="@color/adaptive_text_91a09a"
        android:textSize="12sp" />

    <!-- ========================================== -->
    <!-- MARCA ALIMENTO -->
    <!-- ========================================== -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Marca Alimento"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_spinner_galpon">

        <Spinner
            android:id="@+id/spinnerMarcaAlimento"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:spinnerMode="dropdown"
            android:textColor="@color/adaptive_text_000000" />

    </FrameLayout>

    <!-- ========================================== -->
    <!-- LÍNEAS -->
    <!-- ========================================== -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Líneas"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_spinner_galpon">

        <Spinner
            android:id="@+id/spinnerLineas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:spinnerMode="dropdown"
            android:textColor="@color/adaptive_text_000000" />

    </FrameLayout>

    <!-- ========================================== -->
    <!-- BOTONES -->
    <!-- ========================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- CANCELAR -->


        <!-- CREAR LOTE -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarGalpon"
            android:layout_width="151dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="40"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/cancel_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cancel_background"
            app:cornerRadius="10dp"
            app:strokeColor="@color/cancel_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearLote"
            android:layout_width="150dp"
            android:layout_height="45dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_boton_verde"
            android:text="Crear Lote"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="10dp"
            app:rippleColor="#24845D"
            app:strokeWidth="0dp" />

    </LinearLayout>

</LinearLayout>