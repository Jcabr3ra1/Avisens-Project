<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_dialog_white">

        <!-- ====================================== -->
        <!-- TITULO -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar evento"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="10dp" />

        <!-- ====================================== -->
        <!-- TIPO DE EVENTO -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de evento"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTipoEventoEnfermo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="8dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btnTipoEnfermo">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTipoMurio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="♡  Murió"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:backgroundTint="#F1F7F3"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="#DDE8E2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTipoEnfermo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="♧  Enfermo"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:backgroundTint="#F1F7F3"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="#DDE8E2" />

        </com.google.android.material.button.MaterialButtonToggleGroup>


        <!-- ====================================== -->
        <!-- LOTE -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lote"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/spinnerLoteEnfermo"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_event"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />


        <!-- ====================================== -->
        <!-- FECHA Y CANTIDAD -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:weightSum="2">

            <!-- CANTIDAD DE AVES -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad de aves"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/edtCantidadAvesEnfermo"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_event"
                    android:hint="Ej: 35"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:inputType="number"
                    android:singleLine="true" />

            </LinearLayout>


            <!-- FECHA -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/edtFechaEnfermo"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_event"
                    android:hint="28/08/2026"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:focusable="false"
                    android:clickable="true" />

            </LinearLayout>

        </LinearLayout>


        <!-- ====================================== -->
        <!-- INSUMO -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insumo utilizado"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/spinnerInsumoEnfermo"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_event"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />


        <!-- ====================================== -->
        <!-- DOSIS Y VIA -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:weightSum="2">

            <!-- DOSIS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dosis"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/edtDosisEnfermo"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_event"
                    android:hint="Ej: 0.5 ml por ave"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true" />

            </LinearLayout>


            <!-- VIA DE APLICACION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vía de aplicación"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="5dp" />

                <Spinner
                    android:id="@+id/spinnerViaAplicacionEnfermo"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_event"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ====================================== -->
        <!-- METODO DE REGISTRO -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Método de registro"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/spinnerMetodoRegistroEnfermo"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_event"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />


        <!-- ====================================== -->
        <!-- OBSERVACIONES -->
        <!-- ====================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Observaciones"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/edtObservacionesEnfermo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_observaciones"
            android:gravity="top|start"
            android:hint="Escribe una observación..."
            android:padding="10dp"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:inputType="textMultiLine"
            android:overScrollMode="ifContentScrolls" />


        <!-- ====================================== -->
        <!-- BOTONES -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <!-- CANCELAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarEnfermo"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="3dp"
                app:cornerRadius="9dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D6DED9" />


            <!-- GUARDAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEnfermo"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Guardar tratamiento"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="#2E8B57"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="3dp"
                app:cornerRadius="9dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>