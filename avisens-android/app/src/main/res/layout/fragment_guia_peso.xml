<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F4">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollGuiaPeso"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="18dp">

            <!-- Encabezado inspirado en la versión web -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_guia_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="● PANEL DE ADMINISTRACIÓN"
                        android:textColor="#236B4E"
                        android:textSize="10sp"
                        android:letterSpacing="0.07"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnVolverGuia"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/bg_guia_outline_button"
                        android:text="‹ Volver"
                        android:textColor="#40564C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtTituloGuiaPeso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Guía de peso"
                    android:textColor="#1B3028"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Referencia de crecimiento y planificación del lote."
                    android:textColor="#64736B"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtBreadcrumbGuia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/bg_guia_breadcrumb"
                    android:text="Lotes  ›  Guía de peso"
                    android:textColor="#28664E"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtEstadoCargaGuia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Cargando datos…"
                    android:textColor="#718078"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Indicadores principales: dos columnas, adaptadas a móvil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:background="@drawable/bg_guia_card">
                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:background="@drawable/bg_guia_badge_blue"
                        android:text="D"
                        android:textColor="#426BC0"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtDiaVidaGuia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#1D2D26"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="DÍA ACTUAL"
                            android:textColor="#728078"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="8dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:background="@drawable/bg_guia_card">
                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:background="@drawable/bg_guia_badge_green"
                        android:text="A"
                        android:textColor="#287C5A"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtAvesAlojadasGuia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#1D2D26"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="AVES ALOJADAS"
                            android:textColor="#728078"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:background="@drawable/bg_guia_card">
                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:background="@drawable/bg_guia_badge_orange"
                        android:text="G"
                        android:textColor="#B97718"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtLineaGeneticaGuia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sin asignar"
                            android:textColor="#1D2D26"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="LÍNEA GENÉTICA"
                            android:textColor="#728078"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="8dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:background="@drawable/bg_guia_card">
                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:background="@drawable/bg_guia_badge_yellow"
                        android:text="C"
                        android:textColor="#A77A18"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtPuntosCurvaGuia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#1D2D26"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PUNTOS DE CURVA"
                            android:textColor="#728078"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Información del lote -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="13dp"
                android:background="@drawable/bg_guia_card">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lote"
                    android:textColor="#263B31"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spinnerLotesActivos"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_farm_spinner"
                    android:dropDownWidth="match_parent"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:popupBackground="@drawable/bg_spinner_popup"
                    android:spinnerMode="dropdown"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/txtCodigoLote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="LOT-—"
                    android:textColor="#1E3027"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Galpón" android:textColor="#758078" android:textSize="10sp" />
                        <TextView android:id="@+id/txtGalponGuia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="#24372E" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="34dp" android:background="#E1E8E4" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sexo" android:textColor="#758078" android:textSize="10sp" />
                        <TextView android:id="@+id/txtSexoGuia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="#24372E" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="9dp" android:background="#E1E8E4" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Línea genética" android:textColor="#758078" android:textSize="10sp" />
                        <TextView android:id="@+id/txtLineaGeneticaDetalleGuia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Sin asignar" android:textColor="#24372E" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="34dp" android:background="#E1E8E4" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Día de vida" android:textColor="#758078" android:textSize="10sp" />
                        <TextView android:id="@+id/txtDiaVidaDetalleGuia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="#24372E" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/txtAvesVivasActuales" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
            </LinearLayout>

            <!-- Seguimiento -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="13dp"
                android:background="@drawable/bg_guia_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SEGUIMIENTO" android:textColor="#2A7757" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.09" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Situación real del lote" android:textColor="#20342A" android:textSize="16sp" android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Día actual" android:textColor="#718078" android:textSize="12sp" />
                    <TextView android:id="@+id/txtDiaActualSeguimientoGuia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#24372E" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:background="#E1E8E4" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Último peso verificado" android:textColor="#718078" android:textSize="12sp" />
                    <TextView android:id="@+id/txtUltimoPesoReal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sin peso verificado" android:textColor="#24372E" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/txtFechaUltimoPesaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:background="#E1E8E4" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Peso esperado hoy" android:textColor="#718078" android:textSize="12sp" />
                    <TextView android:id="@+id/txtPesoEsperadoHoy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#24372E" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/txtDesvioPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
            </LinearLayout>

            <!-- Plan productivo / objetivo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="13dp"
                android:background="@drawable/bg_guia_card">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PLAN PRODUCTIVO" android:textColor="#2A7757" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.09" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Objetivo del lote" android:textColor="#20342A" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnRecalcularPlanGuia" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/bg_guia_outline_button" android:text="Recalcular plan" android:textColor="#40564C" android:textSize="10sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Peso objetivo (libras)" android:textColor="#65746B" android:textSize="11sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText
                        android:id="@+id/edtPesoObjetivoLb"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_guia_input"
                        android:hint="Ej. 6.00"
                        android:inputType="numberDecimal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:textColor="#20342A"
                        android:textColorHint="#95A19A"
                        android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="lb" android:textColor="#43564B" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/txtPesoConvertidoG" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="≈ — g" android:textColor="#728078" android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalcularProyeccion"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="7dp"
                    android:text="Calcular objetivo"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#216B4C"
                    app:cornerRadius="7dp"
                    />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="9dp" android:orientation="vertical" android:background="@drawable/bg_guia_card">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peso objetivo" android:textColor="#758078" android:textSize="9sp" />
                        <TextView android:id="@+id/txtPesoObjetivoResumen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="— lb" android:textColor="#20342A" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <View android:layout_width="7dp" android:layout_height="1dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="9dp" android:orientation="vertical" android:background="@drawable/bg_guia_card">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Día objetivo" android:textColor="#758078" android:textSize="9sp" />
                        <TextView android:id="@+id/txtDiaObjetivoPlan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="—" android:textColor="#20342A" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="9dp" android:orientation="vertical" android:background="@drawable/bg_guia_card">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Salida calculada" android:textColor="#758078" android:textSize="9sp" />
                        <TextView android:id="@+id/txtFechaEstimadaSalida" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="—" android:textColor="#20342A" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <View android:layout_width="7dp" android:layout_height="1dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="9dp" android:orientation="vertical" android:background="@drawable/bg_guia_card">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estado" android:textColor="#758078" android:textSize="9sp" />
                        <TextView android:id="@+id/txtEstadoPlanGuia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Sin curva de referencia" android:textColor="#216B4C" android:textSize="11sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/txtAdvertenciaProyeccion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="9dp" android:background="@drawable/bg_badge_regular" android:text="" android:textColor="#765213" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />

                <!-- Campos internos conservados por compatibilidad; la vista web no los muestra como bloques aparte. -->
                <TextView android:id="@+id/txtDiasRestantesSalida" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
                <TextView android:id="@+id/txtRangoFechasSalida" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
                <TextView android:id="@+id/txtMetodoProyeccion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
                <TextView android:id="@+id/txtPesoFaltante" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
                <TextView android:id="@+id/txtGananciaNecesaria" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
            </LinearLayout>

            <!-- Alimento proyectado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="13dp"
                android:background="@drawable/bg_guia_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ALIMENTO PROYECTADO" android:textColor="#2A7757" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.09" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Consumo del ciclo" android:textColor="#20342A" android:textSize="16sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_guia_card">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Por ave" android:textColor="#758078" android:textSize="10sp" />
                        <TextView android:id="@+id/txtConsumoProyectadoPorAve" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="—" android:textColor="#20342A" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
                    </LinearLayout>
                    <View android:layout_width="7dp" android:layout_height="1dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_guia_card">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total del lote" android:textColor="#758078" android:textSize="10sp" />
                        <TextView android:id="@+id/txtAlimentoTotalLote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="— kg" android:textColor="#20342A" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/txtAlimentoPendienteHoy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="9dp" android:background="@drawable/bg_badge_regular" android:text="Sin estimación de alimento" android:textColor="#765213" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/txtConsumoRealPorAve" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
                <TextView android:id="@+id/txtFcrProyectado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="—" />
            </LinearLayout>

            <!-- Referencia de curva -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="13dp"
                android:background="@drawable/bg_guia_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="REFERENCIA DE LA CURVA" android:textColor="#2A7757" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.09" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Referencia para el día actual" android:textColor="#20342A" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtFuenteCurvaGuia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="No hay datos de curva para el día actual." android:textColor="#718078" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
