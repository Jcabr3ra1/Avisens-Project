<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/labelfechaPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fecha del pesaje" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginTop="10dp"/>
        <EditText android:id="@+id/fechaPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="date" android:background="@drawable/bg_bitacora_input" android:padding="12dp" android:textColor="@color/text_primary" android:maxLength="16" android:textColorHint="@color/text_secondary"/>
        <TextView android:id="@+id/labelpromedioPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peso promedio (g)" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginTop="10dp"/>
        <EditText android:id="@+id/promedioPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:background="@drawable/bg_bitacora_input" android:padding="12dp" android:textColor="@color/text_primary" android:maxLength="16" android:textColorHint="@color/text_secondary"/>
        <TextView android:id="@+id/labelmuestraPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aves pesadas (opcional)" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginTop="10dp"/>
        <EditText android:id="@+id/muestraPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:background="@drawable/bg_bitacora_input" android:padding="12dp" android:textColor="@color/text_primary" android:maxLength="16" android:textColorHint="@color/text_secondary"/>
        <TextView android:id="@+id/labelminPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peso mínimo (opcional)" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginTop="10dp" android:visibility="gone"/>
        <EditText android:id="@+id/minPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:background="@drawable/bg_bitacora_input" android:padding="12dp" android:textColor="@color/text_primary" android:maxLength="16" android:visibility="gone" android:textColorHint="@color/text_secondary"/>
        <TextView android:id="@+id/labelmaxPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peso máximo (opcional)" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginTop="10dp" android:visibility="gone"/>
        <EditText android:id="@+id/maxPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:background="@drawable/bg_bitacora_input" android:padding="12dp" android:textColor="@color/text_primary" android:maxLength="16" android:visibility="gone" android:textColorHint="@color/text_secondary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peso objetivo (g) (opcional)" android:textColor="@color/text_primary" android:layout_marginTop="10dp"/>
        <EditText android:id="@+id/objetivoManual" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:background="@drawable/bg_bitacora_input" android:padding="12dp" android:textColor="@color/text_primary"/>
        <TextView android:id="@+id/labelobsPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Observaciones (opcional)" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginTop="10dp"/>
        <EditText android:id="@+id/obsPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:background="@drawable/bg_bitacora_input" android:padding="12dp" android:textColor="@color/text_primary" android:maxLength="500" android:textColorHint="@color/text_secondary"/>
        <TextView android:id="@+id/previewPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peso objetivo: —" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>