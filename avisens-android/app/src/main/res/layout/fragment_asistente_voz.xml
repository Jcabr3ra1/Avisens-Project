<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071819"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <!-- CABECERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnVolverInicioLia"
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardBackgroundColor="#1FFFFFFF"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="←"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloLia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lía"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSubtituloLia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asistente de voz de Avisens"
                    android:textColor="#B9C4C1"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SELECTOR OCULTO: NECESARIO PARA LA LÓGICA EXISTENTE -->
        <TextView
            android:id="@+id/txtEtiquetaGalponLia"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="Galpón" />

        <Spinner
            android:id="@+id/spinnerGalponLia"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:spinnerMode="dropdown" />

        <!-- ONDA DE VOZ -->
        <ImageView
            android:id="@+id/imgWaveLia"
            android:layout_width="260dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="46dp"
            android:contentDescription="Onda de voz"
            android:src="@drawable/ic_lia_wave" />

        <!-- MENSAJE PRINCIPAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="¿Cómo puedo ayudarte con tu granja?"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />

        <!-- MICRÓFONO CON HALO NEÓN -->
        <FrameLayout
            android:layout_width="214dp"
            android:layout_height="214dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp">

            <!--
                El halo se dibuja y anima desde AsistenteVozFragment.kt.
                Su intensidad depende de los niveles de audio.
            -->
            <View
                android:id="@+id/haloMicrofonoLia"
                android:layout_width="214dp"
                android:layout_height="214dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHablarConLia"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text=""
                android:contentDescription="Hablar con Lía"
                app:backgroundTint="#1FCF82"
                app:cornerRadius="55dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_lia_microfono"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="34dp"
                app:iconTint="@android:color/white"
                app:rippleColor="#66FFFFFF"
                app:strokeWidth="0dp" />
        </FrameLayout>

        <!-- ESTADO DE LÍA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#183536"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#2F5755"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_badge_green" />

                <TextView
                    android:id="@+id/txtEstadoVoz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Listo para escucharte"
                    android:textColor="@android:color/white"
                    android:textSize="17sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA DE TRANSCRIPCIÓN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            app:cardBackgroundColor="#1AFFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#26FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lo que dijiste"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTranscripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aquí aparecerá lo que digas..."
                    android:textColor="#D5DCDA"
                    android:textSize="16sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA DE RESPUESTA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1AFFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#26FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Respuesta de Lía"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRespuestaLia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="La respuesta del asistente aparecerá aquí..."
                    android:textColor="#D5DCDA"
                    android:textSize="16sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
