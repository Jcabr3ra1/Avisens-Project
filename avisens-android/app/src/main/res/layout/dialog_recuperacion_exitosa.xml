<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_login_card_elevated"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_recuperacion_exitosa_icono"
        android:contentDescription="@null"
        android:padding="20dp"
        android:src="@drawable/ic_check"
        app:tint="#18875A" />

    <TextView
        android:id="@+id/txtConfirmacionTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="¡Solicitud enviada!"
        android:textColor="@color/adaptive_text_00695c"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtConfirmacionMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Si la cuenta existe, el administrador revisará tu solicitud de recuperación de contraseña."
        android:textColor="@color/adaptive_text_426058"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmacionInicio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_gradient_green"
        android:text="Volver al inicio"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="12dp" />

</LinearLayout>
