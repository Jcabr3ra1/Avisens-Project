<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_dialog_detalles">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ========================================== -->
        <!-- TÍTULO -->
        <!-- ========================================== -->

        <TextView
            android:id="@+id/txtDetalleNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalles"
            android:textColor="#18231F"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloDetalles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Galpón Norte · lote recién creado"
            android:textColor="#89948F"
            android:textSize="11sp" />

        <!-- ========================================== -->
        <!-- DATOS DEL GALPÓN -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- POLLOS -->

            <TextView
                android:id="@+id/txtDetallePollos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_detalles"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Pollos: 4,200"
                android:textColor="#46524D"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- ALIMENTO -->

            <TextView
                android:id="@+id/txtDetalleAlimento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_detalles"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Alimento: Italcol S.A."
                android:textColor="#46524D"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================== -->
        <!-- LÍNEA -->
        <!-- ========================================== -->

        <TextView
            android:id="@+id/txtDetalleLineas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_chip_detalles"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="Líneas: Engorde"
            android:textColor="#46524D"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- ========================================== -->
        <!-- PROYECCIÓN -->
        <!-- ========================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PROYECCIÓN DE CONSUMO · 30 DÍAS"
            android:textColor="#8A9691"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- ========================================== -->
        <!-- CONSUMO TOTAL -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_consumo_total"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtConsumoTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="≈ 7,980 kg"
                android:textColor="#087A58"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alimento total estimado hasta el día 30"
                android:textColor="#087A58"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================== -->
        <!-- GRÁFICA -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_grafica"
            android:padding="8dp">

            <!-- PAQUETE CORRECTO -->
            <com.project.avisensandroid.ConsumoChartView
                android:id="@+id/graficaConsumo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- ========================================== -->
        <!-- TARJETAS DE CONSUMO -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- TARJETA DÍA 1 -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_detalles"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="76 g"
                    android:textColor="#26332E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consumo/ave"
                    android:textColor="#87928D"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="· día 1"
                    android:textColor="#87928D"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- TARJETA DÍA 30 -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_detalles"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="110 g"
                    android:textColor="#26332E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consumo/ave"
                    android:textColor="#87928D"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="· día 30"
                    android:textColor="#87928D"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- TARJETA RITMO DIARIO -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_detalles"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="462 kg"
                    android:textColor="#26332E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ritmo diario"
                    android:textColor="#87928D"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="· día 30"
                    android:textColor="#87928D"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ========================================== -->
        <!-- NOTA -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_nota_detalles"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ⓘ Estimación basada en la curva de consumo estándar Ross 308 para 4.200 aves. Los valores reales pueden variar según manejo, clima y genética."
                android:textColor="#91A09A"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- ========================================== -->
        <!-- BOTONES -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- ATRÁS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAtrasDetalles"
                android:layout_width="100dp"
                android:layout_height="46dp"
                android:text="Atrás"
                android:textAllCaps="false"
                android:textColor="#26332E"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#E8F3ED"
                app:cornerRadius="10dp"
                app:strokeColor="#DDE5E0"
                app:strokeWidth="1dp" />

            <!-- CERRAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarDetalles"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_boton_verde"
                android:text="Cerrar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="10dp"
                app:strokeWidth="0dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>