<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/adaptive_surface_ffffff" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="#8FB9AE" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/adaptive_surface_ffffff" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/adaptive_surface_c4d4ce" />
        </shape>
    </item>

</selector>
