<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/adaptive_surface_e8f3ed" />

            <corners android:radius="12dp" />

            <stroke
                android:width="1dp"
                android:color="#2E9B6F" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/adaptive_surface_ffffff" />

            <corners android:radius="12dp" />

            <stroke
                android:width="1dp"
                android:color="@color/adaptive_surface_dde5e0" />

        </shape>
    </item>

</selector>