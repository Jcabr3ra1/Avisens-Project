<?xml version="1.0" encoding="utf-8"?>
<!--
  Opcional: usa este selector en lugar de bg_input_lavender.xml si quieres
  que el campo muestre un borde verde cuando el usuario lo está editando
  (ayuda a personas con baja alfabetización digital a saber dónde están escribiendo).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E9ECFB" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="#1E9E63" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E9ECFB" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
