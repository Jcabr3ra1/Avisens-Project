<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Spinner seleccionado / con foco -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/white" />

            <stroke
                android:width="1dp"
                android:color="#2E8B57" />

            <corners android:radius="10dp" />

            <padding
                android:left="10dp"
                android:top="0dp"
                android:right="10dp"
                android:bottom="0dp" />

        </shape>
    </item>

    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/white" />

            <stroke
                android:width="1dp"
                android:color="#D6DED9" />

            <corners android:radius="10dp" />

            <padding
                android:left="10dp"
                android:top="0dp"
                android:right="10dp"
                android:bottom="0dp" />

        </shape>
    </item>

</selector>